# Nama aplikasi yang tampil ke pengguna; samakan dengan SID_APP_NAME di backend.
VITE_APP_NAME=SIDUTama
# Host harus sama dengan APP_URL backend (jangan campur localhost dan 127.0.0.1).
VITE_API_URL=http://127.0.0.1:8000
# Harus sama dengan VAPID_PUBLIC_KEY di apps/backend/.env (kosong = push nonaktif).
VITE_VAPID_PUBLIC_KEY=
