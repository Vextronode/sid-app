# Salin menjadi sid.neon.env (chmod 600). Env runtime sid_api untuk mode DB "neon" (FALLBACK).
# Dipakai oleh: deploy.sh <tag> --db neon. Tidak ada sid_db/POSTGRES_* pada mode ini.
# Semua <...> WAJIB diganti; deploy.sh menolak jalan bila masih ada placeholder.

# ---------- Aplikasi (samakan dengan sid.env, termasuk APP_KEY) ----------
APP_NAME=SIDUTama
APP_ENV=production
APP_DEBUG=false
APP_KEY=<APP_KEY>
APP_URL=https://<HOSTNAME_PUBLIK>
FRONTEND_URL=https://<HOSTNAME_PUBLIK>
APP_TIMEZONE=Asia/Jakarta

SANCTUM_STATEFUL_DOMAINS=<HOSTNAME_PUBLIK>
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------- Database Neon ----------
DB_CONNECTION=pgsql
# Runtime memakai host POOLED (mengandung "-pooler"), mis. ep-xxxx-pooler.<region>.aws.neon.tech
# Catatan: kompatibilitas dengan PgBouncer transaction mode belum teruji.
DB_HOST=<NEON_POOLED_HOST>
DB_PORT=5432
DB_DATABASE=<NEON_DATABASE>
DB_USERNAME=<NEON_USER>
DB_PASSWORD=<NEON_PASSWORD>
DB_SSLMODE=require

# Migrasi/seed WAJIB lewat host DIRECT (tanpa "-pooler"). deploy.sh --migrate pada mode
# neon memakai nilai ini sebagai DB_HOST hanya untuk perintah migrasi.
DB_HOST_DIRECT=<NEON_DIRECT_HOST>

# Penanda instance (dipakai skrip). reset-demo.sh selalu menolak mode neon.
SID_ROLE=expo
