# Salin menjadi sid.env (chmod 600). Env runtime sid_api + sid_db untuk mode DB "local".
# Semua <...> WAJIB diganti; deploy.sh menolak jalan bila masih ada placeholder.
# Nilai tanpa tanda kutip, tanpa spasi. Sandi: pakai karakter alfanumerik
# (mis. `openssl rand -hex 24`) agar aman di env_file dan URL.

# ---------- Aplikasi ----------
APP_NAME=SIDUTama
APP_ENV=production
APP_DEBUG=false
# Dibuat SEKALI: echo "base64:$(openssl rand -base64 32)"
# JANGAN diganti setelah dipakai: semua sesi/cookie terenkripsi menjadi tidak valid.
APP_KEY=<APP_KEY>
# URL publik (https, tanpa garis miring akhir). SPA dan API satu origin.
APP_URL=https://<HOSTNAME_PUBLIK>
FRONTEND_URL=https://<HOSTNAME_PUBLIK>
APP_TIMEZONE=Asia/Jakarta

# ---------- Sesi / Sanctum (cookie SPA) ----------
# Hostname publik TANPA skema, eksplisit (tambahkan :port bila bukan 443).
SANCTUM_STATEFUL_DOMAINS=<HOSTNAME_PUBLIK>
SESSION_DRIVER=database
# true: cookie hanya dikirim lewat HTTPS (TLS diakhiri proxy tim).
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

# ---------- Cache / queue / file / mail / log ----------
CACHE_STORE=database
# database: Web Push diantrekan di tabel jobs, dikirim service sid_worker.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------- Database (container sid_db) ----------
DB_CONNECTION=pgsql
# Harus persis nama service DB lokal (reset-demo.sh memeriksanya).
DB_HOST=sid_db
DB_PORT=5432
DB_DATABASE=sid
DB_USERNAME=sid
DB_PASSWORD=<DB_PASSWORD>
DB_SSLMODE=prefer

# Inisialisasi container postgres. HARUS sama dengan DB_DATABASE/DB_USERNAME/DB_PASSWORD
# (deploy.sh memeriksanya). Hanya berlaku saat volume pgdata pertama kali dibuat.
POSTGRES_DB=sid
POSTGRES_USER=sid
POSTGRES_PASSWORD=<DB_PASSWORD>

# ---------- Realtime (Laravel Reverb, service sid_reverb) ----------
# reverb = notifikasi/surat/peringatan diperbarui lewat WebSocket.
# null   = mati; frontend tetap polling (mis. bila proxy tim belum meneruskan WebSocket).
BROADCAST_CONNECTION=reverb
# Dibuat SEKALI per instance: `openssl rand -hex 16` untuk KEY dan SECRET, ID bebas (mis. sid).
# KEY publik (dikirim ke browser); SECRET rahasia, hanya untuk backend.
REVERB_APP_ID=<REVERB_APP_ID>
REVERB_APP_KEY=<REVERB_APP_KEY>
REVERB_APP_SECRET=<REVERB_APP_SECRET>
# Alamat sid_reverb di jaringan internal, untuk sid_worker saat mengirim event.
REVERB_HOST=sid_reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Browser memakai origin halaman (wss://<host publik>/app/..., diteruskan Nginx sid_web).
# Biarkan kosong kecuali WebSocket dilayani di alamat lain.
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=
REVERB_CLIENT_SCHEME=
# Host halaman yang boleh membuka WebSocket (tanpa skema/port).
REVERB_ALLOWED_ORIGINS=<HOSTNAME_PUBLIK>
# Batas koneksi WebSocket serentak. Event loop bawaan Reverb (stream_select)
# hanya sanggup ±1.024 file terbuka; koneksi di atas batas ditolak dan
# browser tersebut kembali polling. Naikkan hanya bila image memasang ext-uv.
REVERB_APP_MAX_CONNECTIONS=900

# ---------- Penanda instance (dipakai skrip, bukan Laravel) ----------
# production : desa sungguhan. reset-demo.sh dan setup.sh --demo DITOLAK (data aman).
# demo       : staging/demo berisi data fiktif. reset-demo.sh boleh mengganti seluruh DB.
SID_ROLE=production

# ---------- Opsional: web push ----------
# Image web dibangun tanpa VITE_VAPID_PUBLIC_KEY, jadi push tidak aktif.
# Bila kelak diaktifkan, isi pasangan kunci (php artisan webpush:vapid):
# VAPID_SUBJECT=mailto:<EMAIL_ADMIN>
# VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
# VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>

# ---------- Opsional: peringatan bencana SIGAP ----------
# Domain SIGAP yang boleh dipakai link_url peringatan (https), dipisah koma.
# Kosong = peringatan yang membawa link_url ditolak 422.
# SIGAP_LINK_HOSTS=<DOMAIN_SIGAP>
