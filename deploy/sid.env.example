# Salin menjadi sid.env (chmod 600). Env runtime sid_api + sid_db untuk mode DB "local".
# Semua <...> WAJIB diganti; deploy.sh menolak jalan bila masih ada placeholder.
# Nilai tanpa tanda kutip, tanpa spasi. Sandi: pakai karakter alfanumerik
# (mis. `openssl rand -hex 24`) agar aman di env_file dan URL.

# ---------- Aplikasi ----------
APP_NAME=SIDUTama
APP_ENV=production
APP_DEBUG=false
# Dibuat SEKALI: echo "base64:$(openssl rand -base64 32)"
# JANGAN diganti setelah dipakai: semua sesi/cookie terenkripsi menjadi tidak valid.
APP_KEY=<APP_KEY>
# URL publik (https, tanpa garis miring akhir). SPA dan API satu origin.
APP_URL=https://<HOSTNAME_PUBLIK>
FRONTEND_URL=https://<HOSTNAME_PUBLIK>
APP_TIMEZONE=Asia/Jakarta

# ---------- Sesi / Sanctum (cookie SPA) ----------
# Hostname publik TANPA skema, eksplisit (tambahkan :port bila bukan 443).
SANCTUM_STATEFUL_DOMAINS=<HOSTNAME_PUBLIK>
SESSION_DRIVER=database
# true: cookie hanya dikirim lewat HTTPS (TLS diakhiri proxy tim).
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

# ---------- Cache / queue / file / mail / log ----------
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------- Database (container sid_db) ----------
DB_CONNECTION=pgsql
# Harus persis nama service DB lokal (reset-demo.sh memeriksanya).
DB_HOST=sid_db
DB_PORT=5432
DB_DATABASE=sid
DB_USERNAME=sid
DB_PASSWORD=<DB_PASSWORD>
DB_SSLMODE=prefer

# Inisialisasi container postgres. HARUS sama dengan DB_DATABASE/DB_USERNAME/DB_PASSWORD
# (deploy.sh memeriksanya). Hanya berlaku saat volume pgdata pertama kali dibuat.
POSTGRES_DB=sid
POSTGRES_USER=sid
POSTGRES_PASSWORD=<DB_PASSWORD>

# ---------- Penanda instance (dipakai skrip, bukan Laravel) ----------
# reset-demo.sh hanya mau jalan bila SID_ROLE=expo.
SID_ROLE=expo

# ---------- Opsional: web push ----------
# Image web expo dibangun tanpa VITE_VAPID_PUBLIC_KEY, jadi push tidak aktif.
# Bila kelak diaktifkan, isi pasangan kunci (php artisan webpush:vapid):
# VAPID_SUBJECT=mailto:<EMAIL_ADMIN>
# VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
# VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>
