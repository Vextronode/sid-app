# Salin menjadi compose.env (chmod 600). Dibaca docker compose lewat --env-file.
# SID_ENV_FILE dan COMPOSE_PROFILES SENGAJA tidak diisi di sini: skrip menentukannya
# dari mode DB (.state/db_mode): local -> sid.env + profil localdb; neon -> sid.neon.env.

# Nama proyek compose (awalan container/volume: sid_db, sid_pgdata, ...).
SID_PROJECT=sid

# Registry image (huruf kecil), mis. ghcr.io/nama-org.
SID_REGISTRY=ghcr.io/<GHCR_OWNER>

# Tag awal. deploy.sh menimpanya dengan tag argumen, skrip lain memakai
# .state/current_tag. Jangan pernah "latest".
SID_IMAGE_TAG=<vX.Y.Z>

# Port host (terikat 127.0.0.1). Hindari 8000, 8080, 3307, 6379 (CiMart).
SID_HTTP_PORT=8100
