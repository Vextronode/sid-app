  * year : SMALLINT
  * last_number : UNSIGNED INT <<DEFAULT 0>>
  created_at : TIMESTAMP <<NULL>>
  updated_at : TIMESTAMP <<NULL>>
  UNIQUE(village_id, letter_type_id, year)
}

