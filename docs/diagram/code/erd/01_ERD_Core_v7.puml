  * nik_hash : VARCHAR(64) <<UNIQUE INDEX>>
  * name : VARCHAR(100)
  date_of_birth : DATE
  place_of_birth : VARCHAR(100)
  * gender : ENUM('L','P')
  * address : TEXT
  rt_id : BIGINT <<FK -> rts, NULL>>
  hamlet_id : BIGINT <<FK -> hamlets, NULL>>
  marital_status : ENUM('belum_kawin',\n'kawin','cerai_hidup','cerai_mati')
  occupation : VARCHAR(100)
  religion : ENUM('islam','kristen',\n'katolik','hindu','buddha','konghucu')
  last_education : ENUM('tidak_sekolah','sd',\n'smp','sma','diploma','s1','s2','s3')
  * domicile_status : ENUM('menetap',\n'merantau_dalam_negeri',\n'merantau_luar_negeri','tki')\nDEFAULT 'menetap'
  current_domicile : VARCHAR(150)
  family_id : UUID <<FK -> families, NULL>>
  family_role : ENUM('kepala_keluarga','istri',\n'suami','anak','famili_lain') <<NULL>>
  father_id : UUID <<FK -> citizens, NULL>>
  mother_id : UUID <<FK -> citizens, NULL>>
  father_name_text : VARCHAR(100) <<NULL>>
  mother_name_text : VARCHAR(100) <<NULL>>
  blood_type : ENUM('A','B','AB','O',\n'tidak_tahu') <<NULL>>
  * residency_type : ENUM('lokal','pendatang')\nDEFAULT 'lokal'
  origin_region : VARCHAR(150) <<NULL>>
  * data_source : ENUM('manual_input_desa',\n'import_excel','dukcapil_sync')\nDEFAULT 'manual_input_desa'
  last_verified_at : TIMESTAMP <<NULL>>
  sync_status : ENUM('synced','pending',\n'conflict') <<NULL>>
  * is_active : BOOLEAN
  created_at : TIMESTAMP <<NULL>>
  updated_at : TIMESTAMP <<NULL>>
}

note right of CIT
  PATCH BESAR v5.0 (Patch 41):
  - Kolom no_kk DIHAPUS TOTAL, pindah ke
    families.no_kk (lihat entity families).
  - Tambah 11 kolom baru: family_id,
    family_role, father_id, mother_id,
    father_name_text, mother_name_text,
    blood_type, residency_type,
    origin_region, data_source,
