@startuml 5.4.1a_v7 ERD Core
skinparam backgroundColor #FFFFFF
skinparam entity {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
  HeaderBackgroundColor #2E5FA3
  HeaderFontColor #FFFFFF
}
skinparam arrow {
  Color #2E5FA3
  FontName Arial
  FontSize 10
}
skinparam linetype ortho

title Entity Relationship Diagram (ERD) v7 - CORE [1/2] - SID Desa Cibenda\n(Wilayah, Pengguna & Jabatan Struktural, Kependudukan (KK+Individu+Sosioekonomi), Surat, Pipeline Approval Dinamis)\nLihat file ERD Pendukung [2/2] untuk: Organisasi Non-Struktural, Notifikasi, Berita, Peraturan Desa\nDiselaraskan v5.1 — Auth & Approval Flow

' ─────────────────────────────────────────────
' WILAYAH
' ─────────────────────────────────────────────

entity "villages" as VIL {
  * id : UUID <<PK>>
  --
  * name : VARCHAR(100)
  * code : VARCHAR(20) <<UNIQUE>>
  head_name : VARCHAR(100)
  address : VARCHAR(255) <<NULL>>
  phone : VARCHAR(20)
  history : TEXT <<NULL>>
  vision : TEXT <<NULL>>
  mission : TEXT <<NULL>>
  created_at : TIMESTAMP <<NULL>>
  updated_at : TIMESTAMP <<NULL>>
}

entity "hamlets" as HAM {
  * id : BIGINT <<PK>>
  --
  * village_id : UUID <<FK -> villages>>
  * name : VARCHAR(100)
  * code : VARCHAR(20) <<UNIQUE>>
  * is_active : BOOLEAN
  created_at : TIMESTAMP <<NULL>>
  updated_at : TIMESTAMP <<NULL>>
}

note right of HAM
  TIDAK BERUBAH dari v4.2/v6.
  5 Dusun Desa Cibenda: Patrol,
  Sinargalih, Cibenda, Budiasih, Sucen
  (di-seed saat instalasi).
end note

entity "rws" as RWS {
  * id : BIGINT <<PK>>
  --
  * hamlet_id : BIGINT <<FK -> hamlets>>
  * village_id : UUID <<FK -> villages>>
  * number : VARCHAR(5)
  * full_label : VARCHAR(20)
  * is_active : BOOLEAN
  created_at : TIMESTAMP <<NULL>>
  updated_at : TIMESTAMP <<NULL>>
}

entity "rts" as RTS {
  * id : BIGINT <<PK>>
  --
  * rw_id : BIGINT <<FK -> rws>>
  * village_id : UUID <<FK -> villages>>
  * number : VARCHAR(5)
  * full_label : VARCHAR(30)
  * is_active : BOOLEAN
  created_at : TIMESTAMP <<NULL>>
  updated_at : TIMESTAMP <<NULL>>
}

note right of RTS
  Hierarki wilayah TIDAK BERUBAH v5.0:
  villages -> hamlets -> rws -> rts.
end note

' ─────────────────────────────────────────────
' PENGGUNA & JABATAN STRUKTURAL
' ─────────────────────────────────────────────

entity "users" as USR {
  * id : UUID <<PK>>
  --
  village_id : UUID <<FK -> villages, NULL>>
  citizen_id : UUID <<FK -> citizens, NULL>>
  * name : VARCHAR(100)
  * username : VARCHAR(30) <<UNIQUE>>
  email : VARCHAR(255) <<UNIQUE, NULL>>
  * password : VARCHAR(255) <<Argon2id>>
  * must_change_password : BOOLEAN <<DEFAULT false>>
  * role : ENUM('warga','rt','rw','kadus',\n'kasi_pelayanan','kaur_tu_umum',\n'petugas_desa','kepala_desa',\n'sekretaris_desa')
  * is_active : BOOLEAN
  email_verified_at : TIMESTAMP
  remember_token : VARCHAR(100)
  created_at : TIMESTAMP <<NULL>>
  updated_at : TIMESTAMP <<NULL>>
}

note right of USR
  v5.1: login memakai username; email
  opsional dan bukan identifier login.
  Role ENUM tetap 9 nilai flat.
  'kadus' TETAP ADA di ENUM untuk
  kompatibilitas akun (login/logout/
  lihat status), namun sejak v5.0 TIDAK
  lagi relevan terhadap
  flow_steps.approver_position.
  citizen_id: NULL diizinkan untuk
  akun teknis tanpa data kependudukan.
end note

entity "families" as FAM {
  * id : UUID <<PK>>
  --
  * no_kk : TEXT <<AES-256 encrypted>>
  * no_kk_hash : VARCHAR(64) <<UNIQUE INDEX>>
  * family_address : TEXT <<AES-256 encrypted>>
  * family_status : ENUM('aktif','pindah','bubar')\nDEFAULT 'aktif'
  * village_id : UUID <<FK -> villages>>
  rt_id : BIGINT <<FK -> rts, NULL>>
  rw_id : BIGINT <<FK -> rws, NULL>>
  hamlet_id : BIGINT <<FK -> hamlets, NULL>>
  head_of_family_id : UUID <<FK -> citizens, NULL>>
