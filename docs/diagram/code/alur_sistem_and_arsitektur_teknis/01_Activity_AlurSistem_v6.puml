'==================================================================================
' SECTION: ACTIVITY DIAGRAM
' FILE: 01_Activity_AlurSistem_v6.puml
' JUDUL: Diagram Alur Sistem (pengajuan sampai Terapkan)
' SUMBER: LetterService, LetterSignatureService, LetterFlowService,
'         RtApprovalService, KadesApprovalService, LetterSnapshotService,
'         LetterFulfillmentService, LetterResultService, MigrantWorkerService
'         (source 2026-11-19); TDD-01 Table 4
' CATATAN: Menggantikan 01_Activity_AlurSistem_v5.puml. Perubahan: verification_type
'          dihapus; form dinamis & tanda tangan pihak terkait; surat ditahan saat RT
'          kosong; FYI Kadus; snapshot & nomor per kode klasifikasi; Terapkan.
'==================================================================================

@startuml Activity_AlurSistem_v6
skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 12
  ArrowColor #2E5FA3
  DiamondBackgroundColor #FFF8E1
  DiamondBorderColor #F9A825
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontName Arial
  FontSize 10
}

title Diagram Alur Sistem - SIDUTama (Flow default RT → Kepala Desa/Sekdes, 2026-11-19)

|#D6E4F7|Pemohon|
|#D5F5E3|Sistem|
|#E3F2FD|Pemilik NIK (saksi)|
|#E8F5E9|RT|
|#FFF3E0|RW / Kadus (FYI)|
|#FDEBD0|Kepala Desa / Sekdes|
|#FFE0B2|Kasi / Kaur|

|Pemohon|
start
:Login; pilih jenis surat aktif\n(ber-template, atau layanan tanpa surat F11);
if (Ada formulir isi tangan?) then (ya)
  :Unduh formulir berisi identitas (A4/F4),\nisi & tanda tangani basah, foto;
endif
:Isi form dinamis (form_fields),\nunggah berkas isian,\nisi NIK saksi (bila diminta);

|Sistem|
:Validasi isian terhadap definisi jenis surat\n(termasuk opsi select bersyarat visible_when);
if (Valid?) then (tidak)
  :422 per field;
  stop
endif
:Simpan surat **pending**\n(snapshot flow_id, NIK terenkripsi);
:Simpan berkas isian (disk privat);
:Catat saksi: ber-akun = permintaan persetujuan;\ntanpa akun = cek RT; luar desa = manual;

while (Masih ada saksi yang menunggu?) is (ya)
  :current_step_order = 0\nlog "Menunggu persetujuan saksi";
  |Pemilik NIK (saksi)|
  :Menerima notifikasi signature_requested;
  if (Tanggapan?) then (setujui + kata sandi)
    :Saksi = signed (persetujuan dicatat);
  else (tolak / kedaluwarsa)
    :Slot = rejected/expired\n(opsional blokir pemohon);
    |Pemohon|
    :Ganti saksi dengan NIK lain;
  endif
  |Sistem|
endwhile (tidak)

:Tentukan step awal\n(lewati tahap non-final milik pemohon);
if (RT wilayah pemohon ada?) then (tidak)
  :Tahan surat di step RT\nlog "Surat ditahan...";
  :Notifikasi approver_vacant ke Staf SIDUTama;
  note right
    Saat Petugas menetapkan RT (promote),
    RT baru langsung diberi tahu surat
    yang menunggunya.
  end note
else (ya)
  :Buat placeholder approval (deadline);
  :Notifikasi "pending" ke RT;
endif

|RT|
:Periksa isian, lampiran, saksi,\ndokumen pendukung;
if (Keputusan RT?) then (tolak)
  |Sistem|
  :rejected, rejected_at_step = 1;\nnotifikasi rt_rejected ke pemohon;
  stop
else (setujui)
endif

|Sistem|
:in_progress; current_step_order = 2;\nplaceholder approval step kepala_desa;
fork
  |RW / Kadus (FYI)|
  :FYI rt_approved_rw_fyi / rt_approved_kadus_fyi\n(read-only, non-blocking);
fork again
  |Sistem|
  :Notifikasi rt_approved ke Kades & Sekdes\n(selain pemohon) dan ke pemohon;
end fork

|Kepala Desa / Sekdes|
:Buka surat di step kepala_desa;
:Putuskan (first-action-wins,\nrow lock + cek ulang);
if (Keputusan?) then (tolak)
  |Sistem|
  :rejected; notifikasi kepala_desa_rejected;
  stop
else (setujui)
endif

|Sistem|
if (produces_letter = false (F11 CPMI)?) then (ya)
  :approved; catat migrant_workers\n(satu baris per keberangkatan,\ntransaksi yang sama);
  :Notifikasi "Pendataan Disetujui" ke pemohon;
  |Pemohon|
  :Lihat Data CPMI Saya di Profil;
  stop
endif
|Sistem|
:approved; letter_number (Persuratan Desa) =\n{kode klasifikasi}/{NNN}/Des/{bulan Romawi}/{tahun};
:expires_at = akhir hari ke-validity_days;
:A01: catat citizen_businesses (Usaha Saya, Cimart);
:Bekukan snapshot render\n(nama Kades saat ini; tanpa TTD/stempel);
:Notifikasi letter_approved_final ke pemohon\n(ambil surat di kantor desa);
:Petugas desa mencetak surat,\nTTD & stempel basah;
if (Layanan Kependudukan (requires_result_upload)?) then (ya)
  |Pemohon|
  :Bawa formulir ke Disdukcapil,\nunggah hasilnya (letter_results);
  |Kasi / Kaur|
  :Verifikasi hasil (terima / tolak + catatan);
  |Sistem|
endif
if (data_action != none?) then (ya)
  :Notifikasi letter_needs_fulfillment\nke Kasi/Kaur sesuai assigned_role;
  |Kasi / Kaur|
  :Tinjau usulan (nilai sekarang vs usulan);
  :Koreksi bila perlu → **Terapkan**;
  |Sistem|
  :Update/tambah citizens (transaksi + lock);\nfulfilled_at/by, fulfillment, audit log;
  :Notifikasi letter_fulfilled ke pemohon;
else (tidak)
  :Notifikasi letter_ready_for_print\nke Kasi/Kaur;
endif

|Pemohon|
:Unduh PDF (dari snapshot, kertas A4/F4)\nselama belum kedaluwarsa;
stop
@enduml
