'==================================================================================
' SECTION: USE CASE DIAGRAM
' FILE: 04_UC_PetugasDesa_KontenKonfigurasi_v6.puml
' JUDUL: Use Case - Staf SIDUTama (3/3: Konten Publik & Konfigurasi Surat)
' SUMBER: TDD-02 v5.3 (UC-18/19/21/24/27/28) + routes (2026-10-18)
' CATATAN: Menggantikan 04_UC_PetugasDesa_KontenKonfigurasi_v5.puml. Tambah: kop
'          surat, logo, foto beranda, kategori berita, lihat flow (read-only).
'          Revisi 2026-10-31: upload stempel dihapus (stempel basah).
'==================================================================================
@startuml UC_PetugasDesa_Konten_v6
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam actor {
  BackgroundColor #D6E4F7
  BorderColor #1F3864
}
title Use Case Diagram - Staf SIDUTama (3/3: Konten Publik & Konfigurasi Surat) [v6]

actor "Staf SIDUTama" as PD

rectangle "SIDUTama" {
  rectangle "UC-18: Profil Desa" #F0F4FF {
    usecase "Edit identitas, kop surat,\nluas, jam layanan, sejarah,\nvisi misi, sambutan Kades" as UC_DESA
    usecase "Atur titik kantor\n(koordinat / link Google Maps)" as UC_LOC
    usecase "Upload logo / foto beranda\n(dioptimasi WebP)" as UC_IMG
  }
  rectangle "UC-19: Berita" #E8F5E9 {
    usecase "Kelola Berita\n(draft/publish, 1-2 kategori)" as UC_NEWS
    usecase "Kelola Kategori Berita" as UC_NEWSCAT
  }
  rectangle "UC-24: Peraturan Desa" #FFF8E1 {
    usecase "Kelola Peraturan Desa" as UC_REG
  }
  rectangle "UC-27: Pengumuman Beranda" #FFF3E0 {
    usecase "Tayangkan / ubah / hapus\npengumuman (durasi wajib)" as UC_ANN
  }
  rectangle "UC-28: Halaman Informasi" #EDE7F6 {
    usecase "Isi PPID, Kebijakan Privasi,\nAksesibilitas (field tunggal\n& daftar dinamis)" as UC_INFO
  }
  rectangle "UC-21: Konfigurasi Jenis Surat" #FDF2F8 {
    usecase "Ubah masa berlaku,\npenugasan Kasi/Kaur,\nstatus aktif" as UC_LT
    usecase "Lihat Flow Approval\n(read-only)" as UC_FLOW
  }
}

PD -- UC_DESA
PD -- UC_LOC
PD -- UC_IMG
PD -- UC_NEWS
PD -- UC_NEWSCAT
PD -- UC_REG
PD -- UC_ANN
PD -- UC_INFO
PD -- UC_LT
PD -- UC_FLOW
UC_NEWS ..> UC_NEWSCAT : <<include>>

note bottom of UC_LT
  Template, isian form, aksi data,
  flow, dan kode klasifikasi diset developer
  lewat seeder (tidak ada endpoint).
end note
note bottom of UC_ANN
  Satu pengumuman per desa. Lewat expires_at
  tidak tampil; dihapus announcements:prune
  (scheduler tiap menit).
end note
note right of UC_DESA
  Perubahan konten menggugurkan cache
  halaman publik desa. Kades/Sekdes tidak
  memiliki akses CMS.
end note
@enduml
