'==================================================================================
' SECTION: USE CASE DIAGRAM
' FILE: 03_UC_PetugasDesa_WilayahJabatan_v5.puml
' JUDUL: Use Case - Petugas Desa (Wilayah, Jabatan & Approval Setting)
' SUMBER: TDD SID Desa Cibenda v5.1 (Section 5.3.2 UC-14/20/22/23)
' CATATAN: Menggantikan 03_UC_PetugasDesa_WilayahJabatan_v4.puml.
'==================================================================================

@startuml 5.3.1b2_v5 UC_Petugas_Desa_Wilayah_Jabatan
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam actor {
  BackgroundColor #D6E4F7
  BorderColor #1F3864
  FontName Arial
  FontSize 12
}

title Use Case Diagram - Petugas Desa (2/3: Wilayah, Jabatan & Approval Setting) [v5.1]

actor "Petugas Desa" as PD
actor "Sistem\n(Otomatis)" as SYS

rectangle "Sistem Informasi Desa (SID) - Desa Cibenda" {

  rectangle "Autentikasi" #F0F4FF {
    usecase "UC-01: Login" as UC_LOGIN
    usecase "UC-02: Logout" as UC_LOGOUT
  }

  rectangle "UC-20: Kelola Struktur\nWilayah" #E1F5FE {
    usecase "Tambah/Edit/Nonaktifkan\nDusun (hamlets)" as UC_HAMLET
    usecase "Tambah/Edit/Nonaktifkan\nRW (rws)" as UC_RW_MGT
    usecase "Tambah/Edit/Nonaktifkan\nRT (rts)" as UC_RT_MGT
  }

  rectangle "UC-14: Kelola User,\nRole & Jabatan Struktural" #F0F4FF {
    usecase "Lihat & perbarui akun\n(non-email)" as UC_USER
    usecase "Promote / Demote\nJabatan Akun" as UC_ASSIGN
    usecase "Rotasi Jabatan\n(akun warga)" as UC_ROTASI
    usecase "Reset Password\nSementara" as UC_RESET
    usecase "Buat Petugas Pertama\n(CLI)" as UC_FIRST
  }

  rectangle "UC-22: Kelola Setting\nDeadline Approval" #FFF3E0 {
    usecase "Edit deadline_hours &\nreminder_hours per tahap" as UC_DEADLINE
  }

  rectangle "UC-23: Kelola Organisasi\nDesa (Non-Struktural)" #F3E5F5 {
    usecase "Kelola Jabatan &\nAnggota BPD" as UC_BPD
    usecase "Kelola Jabatan &\nAnggota BUMDES" as UC_BUMDES
    usecase "Kelola Jabatan &\nAnggota LPM" as UC_LPM
    usecase "Kelola Jabatan &\nAnggota Karang Taruna" as UC_KT
    usecase "Kelola Jabatan &\nAnggota PKK" as UC_PKK
  }

  rectangle "Notifikasi" #FFF8E1 {
    usecase "Kirim Notifikasi\n(Otomatis)" as UC_NOTIF_SND
  }

  rectangle "Fitur Pendukung" #FDF2F8 {
    usecase "UC-15: Lihat Dashboard\nOperasional" as UC_DASH
  }
}

PD -- UC_LOGIN
PD -- UC_LOGOUT
PD -- UC_HAMLET
PD -- UC_RW_MGT
PD -- UC_RT_MGT
PD -- UC_USER
PD -- UC_ASSIGN
PD -- UC_ROTASI
PD -- UC_RESET
SYS -- UC_FIRST
PD -- UC_DEADLINE
PD -- UC_BPD
PD -- UC_BUMDES
PD -- UC_LPM
PD -- UC_KT
PD -- UC_PKK
PD -- UC_DASH

SYS -- UC_NOTIF_SND

UC_ASSIGN ..> UC_ROTASI : <<extend>>
UC_ROTASI ..> UC_NOTIF_SND : <<trigger>>
UC_HAMLET ..> UC_RW_MGT : <<extend>>
UC_RW_MGT ..> UC_RT_MGT : <<extend>>

note bottom of UC_ROTASI
  Promote/demote/rotate mengubah official
  aktif dan users.role dalam satu transaksi.
  Rotasi mempertahankan posisi/wilayah;
  petugas_desa memakai promote/demote dan
  tidak dapat dirotasi.
end note

note bottom of UC_USER
  Akun pejabat tidak dibuat melalui POST
  /users. Akun warga yang aktif dan
  terhubung ke citizen dipromosikan.
  Perubahan role jabatan dilakukan via
  promote/demote/rotate; update akun hanya
  name/is_active dan tidak menerima email.
  Reset password menghasilkan password
  sementara; target bukan diri sendiri atau
  petugas_desa.
end note

note bottom of UC_DEADLINE
  API hanya menampilkan dan menerima level
  approver RT dan Kades. Sekdes memutuskan
  melalui step `kepala_desa`. Kasi/Kaur
  bukan level approval. Jika deadline lewat,
  surat tidak auto-reject.
end note

note bottom of UC_BPD
  Fitur rotasi (tambah anggota, ganti jabatan)
  status: PENDING konfirmasi desa.
  Tabel sudah ada (village_org_positions,
  village_org_members), toggle UI menyusul.
  TIDAK BERUBAH dari v4.2.
end note

@enduml

'==================================================================================
' SINKRONISASI v5.1 — AUTH & APPROVAL FLOW:
' - Manajemen akun menggunakan promote/demote/rotate; pembuatan Petugas pertama via CLI.
' - Petugas terakhir dan self-demote dilindungi guard; reset password bersifat sementara.
' - Approval settings aktif dibatasi pada level RT/Kades; Sekdes/Kasi/Kaur
'   tetap ada sebagai nilai legacy enum database.
