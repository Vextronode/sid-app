'==================================================================================
' SECTION: USE CASE DIAGRAM
' FILE: 03_UC_PetugasDesa_WilayahJabatan_v6.puml
' JUDUL: Use Case - Petugas Desa (2/3: Wilayah, Akun, Jabatan, Organisasi)
' SUMBER: TDD-02 v5.3 (UC-14/20/22/23) + routes (2026-10-16)
' CATATAN: Menggantikan 03_UC_PetugasDesa_WilayahJabatan_v5.puml. Tambah: jenis
'          jabatan tanpa akun, cari calon via NIK, foto pejabat, reset TTD akun.
'==================================================================================
@startuml UC_PetugasDesa_Jabatan_v6
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam actor {
  BackgroundColor #D6E4F7
  BorderColor #1F3864
}
title Use Case Diagram - Petugas Desa (2/3: Wilayah, Akun, Jabatan & Organisasi) [v6]

actor "Petugas Desa" as PD
actor "Developer/Operator\n(CLI)" as DEV

rectangle "SIDUTama" {
  rectangle "UC-20: Struktur Wilayah" #F0F4FF {
    usecase "Kelola Dusun / RW / RT" as UC_REGION
  }
  rectangle "UC-14: Akun & Jabatan" #E8F5E9 {
    usecase "Kelola akun\n(ubah, aktif/nonaktif)" as UC_USER
    usecase "Reset Password Sementara" as UC_RESETPW
    usecase "Reset Tanda Tangan Akun" as UC_RESETSIG
    usecase "Cari Calon Pejabat via NIK" as UC_CAND
    usecase "Tetapkan Pejabat (promote)\nberakun / tanpa akun + foto" as UC_PROMOTE
    usecase "Turunkan (demote)" as UC_DEMOTE
    usecase "Rotasi Pejabat" as UC_ROTATE
    usecase "Ganti Foto Pejabat" as UC_PHOTO
    usecase "Upload/Preview TTD\nKepala Desa" as UC_KADESSIG
    usecase "Kelola Jenis Jabatan\nTanpa Akun" as UC_POSTYPE
    usecase "Buat Petugas Pertama\n(petugas:first)" as UC_FIRST
  }
  rectangle "UC-22: Deadline Approval" #FFF8E1 {
    usecase "Atur deadline_hours /\nreminder_hours (rt, kepala_desa)" as UC_DEADLINE
  }
  rectangle "UC-23: Organisasi Non-Struktural" #FDF2F8 {
    usecase "Kelola Jabatan & Anggota\nBPD / BUMDES / LPM /\nKarang Taruna / PKK" as UC_ORG
  }
}

PD -- UC_REGION
PD -- UC_USER
PD -- UC_RESETPW
PD -- UC_RESETSIG
PD -- UC_CAND
PD -- UC_PROMOTE
PD -- UC_DEMOTE
PD -- UC_ROTATE
PD -- UC_PHOTO
PD -- UC_KADESSIG
PD -- UC_POSTYPE
PD -- UC_DEADLINE
PD -- UC_ORG
DEV -- UC_FIRST
UC_PROMOTE ..> UC_CAND : <<include>>
UC_ROTATE ..> UC_CAND : <<include>>
UC_ROTATE ..> UC_KADESSIG : <<extend>>\n(rotasi Kades)

note bottom of UC_PROMOTE
  Jabatan berakun mengubah users.role;
  jabatan tanpa akun (official_position_types)
  tidak. Satu-pemegang per wilayah → 409.
end note
note bottom of UC_DEADLINE
  Scheduler mengirim 1 pengingat ke approver
  reminder_hours sebelum deadline; overdue
  tetap penanda saat daftar dimuat.
end note
@enduml
