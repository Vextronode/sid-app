'==================================================================================
' SECTION: USE CASE DIAGRAM
' FILE: 06_UC_RT_v5.puml
' JUDUL: Use Case - RT
' SUMBER: TDD SID Desa Cibenda v5.1 (Section 5.3.2 UC-04a, Table 9)
' CATATAN: Menggantikan 06_UC_RT_v4.puml. RT tetap approver tahap 1, TAPI
'          target notifikasi setelah approve berubah signifikan.
'==================================================================================

@startuml 5.3.1d_v5 UC_RT
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam actor {
  BackgroundColor #D6E4F7
  BorderColor #1F3864
  FontName Arial
  FontSize 12
}

title Use Case Diagram - RT (Approver Step Berbasis Wilayah) [v5.1]

actor "RT" as RT
actor "Sistem\n(Otomatis)" as SYS

rectangle "Sistem Informasi Desa (SID) - Desa Cibenda" {

  rectangle "Autentikasi" #F0F4FF {
    usecase "UC-01: Login" as UC_LOGIN
    usecase "UC-02: Logout" as UC_LOGOUT
  }

  rectangle "UC-04a: Approval RT\n(Tahap 1, Berbasis Wilayah)" #E8FFE8 {
    usecase "UC-05: Lihat Daftar Surat\nWilayah RT (step aktif = rt)" as UC_RT_LIST
    usecase "UC-06: Lihat Detail\nPermohonan" as UC_RT_DETAIL
    usecase "Approve / Reject Surat" as UC_RT_APPROVE
  }

  rectangle "Notifikasi" #FFF8E1 {
    usecase "Terima Notifikasi\nPermohonan Baru" as UC_NOTIF_IN
    usecase "Kirim Notifikasi\n(Otomatis, Paralel)" as UC_NOTIF_SND
  }

  rectangle "Fitur Pendukung" #FDF2F8 {
    usecase "UC-15: Dashboard RT\n(Ringkasan Wilayah + Badge Overdue)" as UC_DASH
  }
}

RT -- UC_LOGIN
RT -- UC_LOGOUT
RT -- UC_RT_LIST
RT -- UC_RT_DETAIL
RT -- UC_RT_APPROVE
RT -- UC_NOTIF_IN
RT -- UC_DASH

SYS -- UC_NOTIF_SND

UC_RT_APPROVE ..> UC_NOTIF_SND : <<trigger>>
UC_RT_LIST ..> UC_RT_DETAIL : <<include>>
UC_RT_DETAIL ..> UC_RT_APPROVE : <<extend>>

note "RT hanya bisa approve surat di wilayahnya\nsendiri. Gate: cek rt_id (via OfficialService,\nresolve BERBASIS WILAYAH - berbeda dengan\nresolve Kades/Sekdes/Kasi/Kaur yang berbasis\nposisi murni). TIDAK BERUBAH dari v4.2." as NOTE1

note "*** ALUR v5.1 ***\nRT hanya melihat surat bila step RT sedang\naktif; tahap RT milik pemohon pejabat dapat\ndilewati sesuai aturan applicant-official.\nJika RT approve, alur memilih nextActionable:\nstep non-final milik pemohon dapat dilewati,\nstep kosong tidak dilewati, dan final Kades/\nSekdes selalu dipertahankan. FYI RW hanya\nterkirim setelah keputusan approve RT, bukan\njika tahap RT dilewati. Reject bersifat terminal." as NOTE2

note "Placeholder letter_approvals untuk step aktif\ndiperbarui saat keputusan dicatat (flow_step_id\nmenjadi referensi audit). Saat approve, sistem\nmembuat placeholder ber-deadline untuk step\nberikutnya; saat reject, tidak ada deadline lanjutan." as NOTE3

@enduml

'==================================================================================
' SINKRONISASI v5.1: RT hanya menangani step RT aktif di wilayahnya.
' Resolve nextActionable dinamis; RW FYI non-blocking tanpa fallback.
