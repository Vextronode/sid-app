'==================================================================================
' SECTION: USE CASE DIAGRAM
' FILE: 09_UC_KasiKaur_v5.puml
' JUDUL: Use Case - Kasi/Kaur (Notifikasi & Baca/Unduh)
' SUMBER: TDD SID Desa Cibenda v5.1 (Section 5.3.2 UC-04d, Table 9)
' CATATAN: v5.1 mengubah Kasi/Kaur menjadi read-only setelah final approval.
'==================================================================================

@startuml 5.3.1g_v5 UC_Kasi_Kaur
left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam actor {
  BackgroundColor #D6E4F7
  BorderColor #1F3864
  FontName Arial
  FontSize 12
}

title Use Case Diagram - Kasi Pelayanan & Kaur TU Umum (Notifikasi & Baca/Unduh) [v5.1]

actor "Kasi\nPelayanan" as KASI
actor "Kaur TU\n& Umum" as KAUR
actor "Sistem\n(Otomatis)" as SYS

rectangle "Sistem Informasi Desa (SID) - Desa Cibenda" {

  rectangle "Autentikasi" #F0F4FF {
    usecase "UC-01: Login" as UC_LOGIN
    usecase "UC-02: Logout" as UC_LOGOUT
  }

  rectangle "UC-04d: Notifikasi & Akses Surat\n(Read-Only Setelah Approved)" #FFE0B2 {
    usecase "UC-05: Lihat Daftar Surat\n(approved + assigned_role cocok)" as UC_KASI_LIST
    usecase "UC-06: Lihat Detail Permohonan\n& Seluruh Riwayat\n(RT + FYI RW + Kades/Sekdes)" as UC_KASI_DETAIL
    usecase "Download / Cetak Surat\n(PDF)" as UC_KASI_DOWNLOAD
  }

  rectangle "Notifikasi" #FFF8E1 {
    usecase "Terima Notifikasi\nSurat Final Disetujui" as UC_NOTIF_IN
  }

  rectangle "Fitur Pendukung" #FDF2F8 {
    usecase "UC-15: Dashboard Kasi/Kaur\n(Surat Selesai + Notifikasi Belum Dibaca)" as UC_DASH
  }
}

KASI -- UC_LOGIN
KASI -- UC_LOGOUT
KASI -- UC_KASI_LIST
KASI -- UC_KASI_DETAIL
KASI -- UC_KASI_DOWNLOAD
KASI -- UC_NOTIF_IN
KASI -- UC_DASH

KAUR -- UC_LOGIN
KAUR -- UC_LOGOUT
KAUR -- UC_KASI_LIST
KAUR -- UC_KASI_DETAIL
KAUR -- UC_KASI_DOWNLOAD
KAUR -- UC_NOTIF_IN
KAUR -- UC_DASH

UC_KASI_LIST ..> UC_KASI_DETAIL : <<include>>
UC_KASI_DETAIL ..> UC_KASI_DOWNLOAD : <<extend>>

note "Kasi Pelayanan dan Kaur TU Umum digabung dalam 1 diagram karena\nakses baca/unduh surat approved memakai letter_types.assigned_role.\nassigned_role=NULL memberi akses kepada keduanya." as NOTE1

note "*** PERUBAHAN v5.1: BUKAN APPROVER ***\nKasi/Kaur bukan anggota flow approval dan tidak\nmemiliki endpoint keputusan. Setelah Kades/Sekdes\nmenyetujui tahap final, Kasi/Kaur menerima notifikasi\nserta dapat membaca dan mengunduh surat approved yang\nsesuai assigned_role." as NOTE2

note "Status harus approved untuk akses daftar/detail/unduh.\nNomor surat dan expires_at dibuat pada final approval\nKades/Sekdes. Jika assigned_role NULL, kedua role Kasi\nmaupun Kaur dapat mengakses." as NOTE3

note "Kasi/Kaur menerima notifikasi hanya setelah final approval.\nKades/Sekdes adalah aktor yang memutuskan, dan aktor aktual\ntercatat pada riwayat approval." as NOTE4

@enduml

'==================================================================================
' SINKRONISASI v5.1 — UC-04d adalah notifikasi + baca/unduh read-only.
' Kasi/Kaur bukan approver; final, nomor surat, dan expiry diproses oleh Kades/Sekdes.
'==================================================================================
' Riwayat revisi v5.0 dihapus karena asumsi Kasi/Kaur sebagai approver
' tidak berlaku pada kontrak aktif v5.1.
