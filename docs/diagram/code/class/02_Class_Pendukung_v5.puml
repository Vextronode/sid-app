package "Eloquent Model Layer" #FDE8D8 {

  class VillageOrgPosition {
    +id : bigint
    +villageId : bigint
    +orgType : enum
    +positionLabel : string
    +isSingleOccupant : bool
    +sortOrder : int
    +isActive : bool
    --
    +village() : BelongsTo
    +members() : HasMany
    +activeMembers() : HasMany
  }

  class VillageOrgMember {
    +id : bigint
    +positionId : bigint
    +memberName : string
    +photoImg : string?
    +phoneWa : string?
    +startedAt : date
    +endedAt : date?
    +isActive : bool
    +notes : string?
    --
    +position() : BelongsTo
    +isCurrentlyActive() : bool
  }

  class Notification {
    +id : uuid
    +type : string
    +notifiableType : string
    +notifiableId : bigint
    +data : json
    +readAt : datetime?
    --
    +notifiable() : MorphTo
    +isUnread() : bool
    note right
      STRUKTUR TABEL TIDAK BERUBAH dari v4.2.
      Polymorphic relation - notifiable
      biasanya App\\Models\\User.
      data (json) kini bisa berisi payload
      generik berbeda tergantung event
      pemicu (FlowStepAdvanced vs RwFyi vs
      broadcast fallback), tapi struktur
      kolom Model ini sendiri sama sekali
      tidak berubah.
    end note
  }

  class News {
    +id : bigint
    +villageId : bigint
    +authorId : bigint
    +title : string
    +slug : string
    +content : string
    +thumbnail : string?
    +isPublished : bool
    +publishedAt : datetime?
    --
    +village() : BelongsTo
    +author() : BelongsTo
    +isVisibleToPublic() : bool
    note right
      TIDAK BERUBAH dari v4.2. Aktor UC-19
      TETAP HANYA Petugas Desa - Kepala
      Desa dan Sekretaris Desa TIDAK
      memiliki akses.
    end note
  }

  class VillageRegulation {
    +id : bigint
    +villageId : bigint
    +regulationNumber : string
    +title : string
    +content : string
    +enactedDate : date?
    +createdBy : bigint
    --
    +village() : BelongsTo
    +creator() : BelongsTo
    note right
      TIDAK BERUBAH dari v4.2. TIDAK ADA
      isPublished - selalu tampil di halaman
      publik begitu dibuat.
    end note
  }
}

' ═══════════════════════════════════════════════════
' EVENT / LISTENER (Ilustrasi Alur Notifikasi Generik v5.0)
' ═══════════════════════════════════════════════════

package "Event & Listener Layer (Ilustrasi Alur v5.0)" #FFF3E0 {

  class "FlowStepAdvanced\n<<Event>>" as EvtFlowStep {
    +letter : Letter
    +previousStep : FlowStep?
    +nextStep : FlowStep?
  }

  class "FlowStepNotificationListener\n<<Listener>>" as ListenerFlowStep {
    +handle(FlowStepAdvanced) : void
  }

  note bottom of EvtFlowStep
    *** BARU v5.0 (SID-ARCH-BE-001 S7) ***
    Event GENERIK - dipicu SETIAP kali
    current_step_order berpindah (approve),
    MENGGANTIKAN Event spesifik per posisi
    (RtApproved, RwApproved, dst - v4.2).
    Dipicu oleh LetterService (lihat Class
    Core [1/2]) setelah advanceToNextStep().
  end note

  note bottom of ListenerFlowStep
    SATU Listener generik menggantikan
    kebutuhan Listener terpisah per tahap.
    Membaca nextStep.approverPosition,
    resolve approver lewat OfficialService
    (lihat Class Core [1/2]:
    resolveByPositionOnly() atau
    resolveRtForCitizen() tergantung
    posisi), lalu memanggil
    NotificationService.notifyFlowStepAdvanced().
    SECARA TERPISAH/PARALEL (dalam handler
    yang sama, non-blocking terhadap
    resolve approver berikutnya), listener
    ini juga memicu
    NotificationService.notifyRwFyi() jika
    previousStep.approverPosition = 'rt'
    (RT baru saja approve).
  end note
}

