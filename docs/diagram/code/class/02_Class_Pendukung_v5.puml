' LAYER 2: SERVICE (Business Logic)
' ═══════════════════════════════════════════════════

package "Service Layer" #D5EAD0 {

  class VillageOrgService {
    +createPosition(data) : VillageOrgPosition
    +assignMember(positionId, data) : VillageOrgMember
    +rotateMember(memberId, newData) : VillageOrgMember
    note right
      STATUS: fitur rotasi PENDING
      konfirmasi desa (statis vs dinamis).
      TIDAK BERUBAH dari v4.2 (TDD Table 69).
    end note
  }

  class VillageProfileService {
    +getProfile(villageId) : Village
    +updateProfile(villageId, data) : Village
  }

  class NewsService {
    +createNews(data, authorId) : News
    +generateUniqueSlug(title) : string
    +publish(newsId) : News
  }

  class RegulationService {
    +createRegulation(data, createdBy) : VillageRegulation
    note right
      Tidak ada konsep publish/draft -
      begitu dibuat, otomatis publik.
      TIDAK BERUBAH dari v4.2.
    end note
  }

  class ContactService {
    +getActiveKasiKaurContacts(villageId) : Collection
  }

  class NotificationService {
    +getUnreadForUser(userId) : Collection
    +markAsRead(notificationId) : bool
    +broadcastToRole(role, data) : void
    +notifyFlowStepAdvanced(letter, nextStep) : void
    +notifyRwFyi(letter) : void
    note right
      *** PERUBAHAN v5.0 (SID-ARCH-BE-001 S7) ***
      TAMBAH notifyFlowStepAdvanced() - dipicu
      SATU kali oleh Event generik
      FlowStepAdvanced setiap kali
      current_step_order berpindah (approve),
      MENGGANTIKAN kebutuhan listener terpisah
      per posisi (RtApproved/RwApproved/dst
      seperti v4.2). Method ini resolve
      approver di step berikutnya lewat
      OfficialService sesuai approverPosition
      pada FlowStep aktif.
      TAMBAH notifyRwFyi() - dipanggil SECARA
      PARALEL/BERSAMAAN dengan
      notifyFlowStepAdvanced() (bukan
      berurutan menunggu), karena RW TIDAK
      PERNAH berada di jalur kritis proses -
      murni side-effect non-blocking.
      broadcastToRole() TETAP dipakai untuk
      fallback RT/RW kosong, TIDAK BERUBAH.
    end note
  }
}

