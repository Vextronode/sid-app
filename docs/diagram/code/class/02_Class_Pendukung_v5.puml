' ═══════════════════════════════════════════════════
' LAYER 1: CONTROLLER
' ═══════════════════════════════════════════════════

package "Controller Layer" #F0F4FF {

  class VillageOrgPositionController {
    +index(IndexVillageOrgPositionRequest) : JsonResponse
    +show(id) : JsonResponse
    +store(StoreVillageOrgPositionRequest) : JsonResponse
    +update(id, UpdateVillageOrgPositionRequest) : JsonResponse
    +destroy(id) : JsonResponse
  }
  class VillageOrgMemberController {
    +store(position, AddVillageOrgMemberRequest) : JsonResponse
    +update(position, id, UpdateVillageOrgMemberRequest) : JsonResponse
    +destroy(position, id) : JsonResponse
  }

  class VillageProfileController {
    +show() : JsonResponse
    +update(UpdateProfileRequest) : JsonResponse
    note right
      Aktor HANYA Petugas Desa. Kepala Desa
      DAN Sekretaris Desa TIDAK memiliki
      akses - ditegaskan ulang eksplisit
      di SID-ARCH-SYS-001 S2.3: domain CMS
      eksklusif petugas_desa, TIDAK meluas
      meski Kades/Sekdes kini approver aktif
      di domain Surat (v5.0).
    end note
  }

  class NewsController {
    +index() : JsonResponse
    +store(StoreNewsRequest) : JsonResponse
    +update(id, UpdateNewsRequest) : JsonResponse
    +destroy(id) : JsonResponse
    note right
      Aktor HANYA Petugas Desa, sama seperti
      VillageProfileController. TIDAK BERUBAH
      dari v4.2.
    end note
  }

  class RegulationController {
    +index() : JsonResponse
    +store(StoreRegulationRequest) : JsonResponse
    +update(id, UpdateRegulationRequest) : JsonResponse
    +destroy(id) : JsonResponse
  }

  class PublicPageController {
    +home() : JsonResponse
    +villageProfile() : JsonResponse
    +newsList() : JsonResponse
    +regulationList() : JsonResponse
    +letterTypeList() : JsonResponse
    +contactUs() : JsonResponse
  }

  class NotificationController {
    +index() : JsonResponse
    +markAsRead(id) : JsonResponse
  }
}

' ═══════════════════════════════════════════════════
' LAYER 2: SERVICE (Business Logic)
' ═══════════════════════════════════════════════════

package "Service Layer" #D5EAD0 {

  class VillageOrgPositionService { +list(user, orgType) : Collection; +create(user, data) : VillageOrgPosition }
  class VillageOrgMemberService { +addOrRotate(user, position, data) : VillageOrgMember; +update(user, position, id, data) : VillageOrgMember }

  class VillageProfileService {
    +getProfile(villageId) : Village
    +updateProfile(villageId, data) : Village
  }

  class NewsService {
    +createNews(data, authorId) : News
    +generateUniqueSlug(title) : string
    +publish(newsId) : News
  }

  class RegulationService {
    +createRegulation(data, createdBy) : VillageRegulation
    note right
      Tidak ada konsep publish/draft -
      begitu dibuat, otomatis publik.
      TIDAK BERUBAH dari v4.2.
    end note
  }

  class PublicPageService { +home(user) : array; +contactUs(data) : PublicContactResource }

  class NotificationService {
    +getForUser(user) : Collection
    +markAsRead(user, id) : void
    +markAllAsRead(user) : void
    +getUnreadCount(user) : int
    note right
      Service ini mengelola pembacaan notifikasi.
      Pengiriman LetterStatusNotification dilakukan
      oleh LetterService, RtApprovalService, dan
      KadesApprovalService.
    end note
  }
}

' ═══════════════════════════════════════════════════
' LAYER 3: REPOSITORY (Data Access)
' ═══════════════════════════════════════════════════

package "Repository Layer" #C8E6C9 {

  class VillageOrgPositionRepository { }
  class VillageOrgMemberRepository { }

  class VillageRepository {
    +findById(id) : Village
    +update(village, data) : Village
  }

  class NewsRepository {
    +findAllByVillage(villageId) : Collection
    +findPublished(villageId) : Collection
    +create(data) : News
    +update(news, data) : News
    +delete(id) : bool
  }

  class RegulationRepository {
    +findAllByVillage(villageId) : Collection
    +create(data) : VillageRegulation
    +update(regulation, data) : VillageRegulation
    +delete(id) : bool
  }

  class NotificationRepository { +allForUserLatestFirst(user) : Collection; +markAsRead(notification) : void; +markAllAsReadForUser(user) : void }
}

' ═══════════════════════════════════════════════════
' LAYER 4: ELOQUENT MODEL (Domain)
' ═══════════════════════════════════════════════════

package "Eloquent Model Layer" #FDE8D8 {

  class VillageOrgPosition {
    +id : bigint
    +villageId : bigint
    +orgType : enum
    +positionLabel : string
    +isSingleOccupant : bool
    +sortOrder : int
    +isActive : bool
    --
    +village() : BelongsTo
    +members() : HasMany
    +activeMembers() : HasMany
  }

  class VillageOrgMember {
    +id : bigint
    +positionId : bigint
    +memberName : string
    +photoImg : string?
    +phoneWa : string?
    +startedAt : date
    +endedAt : date?
    +isActive : bool
    +notes : string?
    --
    +position() : BelongsTo
    +isCurrentlyActive() : bool
  }

  class Notification <<Laravel framework>> {
    +id : uuid
    +type : string
    +notifiableType : string
    +notifiableId : bigint
    +data : json
    +readAt : datetime?
    --
    +notifiable() : MorphTo
    +isUnread() : bool
    note right
      STRUKTUR TABEL TIDAK BERUBAH dari v4.2.
      Polymorphic relation - notifiable
      biasanya App\\Models\\User.
      data (json) kini bisa berisi payload
      generik berbeda tergantung event
      pemicu (FlowStepAdvanced vs RwFyi vs
      notifikasi FYI RW), tapi struktur
      kolom Model ini sendiri sama sekali
      tidak berubah.
    end note
  }

  class News {
    +id : bigint
    +villageId : bigint
    +authorId : bigint
    +title : string
    +slug : string
    +content : string
    +thumbnail : string?
    +isPublished : bool
    +publishedAt : datetime?
    --
    +village() : BelongsTo
    +author() : BelongsTo
    +isVisibleToPublic() : bool
    note right
      TIDAK BERUBAH dari v4.2. Aktor UC-19
      TETAP HANYA Petugas Desa - Kepala
      Desa dan Sekretaris Desa TIDAK
      memiliki akses.
    end note
  }

  class VillageRegulation {
    +id : bigint
    +villageId : bigint
    +regulationNumber : string
    +title : string
    +content : string
    +enactedDate : date?
    +createdBy : bigint
    --
    +village() : BelongsTo
    +creator() : BelongsTo
    note right
      TIDAK BERUBAH dari v4.2. TIDAK ADA
      isPublished - selalu tampil di halaman
      publik begitu dibuat.
    end note
  }
}

