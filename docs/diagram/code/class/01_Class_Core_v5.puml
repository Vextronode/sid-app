package "Eloquent Model Layer" #FDE8D8 {

  class Village {
    +id : bigint
    +name : string
    +code : string
    +headName : string
    --
    +hamlets() : HasMany
    +users() : HasMany
    +citizens() : HasMany
    +families() : HasMany
    +officials() : HasMany
    +letters() : HasMany
  }

  class Hamlet {
    +id : bigint
    +villageId : bigint
    +name : string
    +code : string
    +isActive : bool
    --
    +village() : BelongsTo
    +rws() : HasMany
    +officials() : HasMany
    +citizens() : HasMany
  }

  class Rw {
    +id : bigint
    +hamletId : bigint
    +number : string
    +fullLabel : string
    +isActive : bool
    --
    +hamlet() : BelongsTo
    +rts() : HasMany
    +officials() : HasMany
  }

  class Rt {
    +id : bigint
    +rwId : bigint
    +number : string
    +fullLabel : string
    +isActive : bool
    --
    +rw() : BelongsTo
    +citizens() : HasMany
    +officials() : HasMany
  }

  class User {
    +id : bigint
    +villageId : bigint
    +citizenId : bigint?
    +name : string
    +email : string
    -password : string
    +role : enum
    +isActive : bool
    --
    +village() : BelongsTo
    +citizen() : BelongsTo
    +official() : HasOne
    +submittedLetters() : HasMany
    +approvals() : HasMany
    note right
      role ENUM TETAP 9 nilai (TIDAK
      BERUBAH dari v4.2): warga, rt, rw,
      kadus, kasi_pelayanan, kaur_tu_umum,
      petugas_desa, kepala_desa,
      sekretaris_desa.
    end note
  }

  class Citizen {
    +id : bigint
    +villageId : bigint
    -nik : string <<encrypted>>
    +nikHash : string
    +name : string
    +gender : enum
    -address : string <<encrypted>>
    +rtId : bigint?
    +hamletId : bigint?
    +domicileStatus : enum
    +currentDomicile : string?
    +familyId : bigint?
    +familyRole : enum?
    +fatherId : bigint?
    +motherId : bigint?
    +fatherNameText : string?
    +motherNameText : string?
    +bloodType : enum?
    +residencyType : enum
    +originRegion : string?
    +dataSource : enum
    +lastVerifiedAt : datetime?
    +syncStatus : enum?
    +isActive : bool
    --
    +village() : BelongsTo
    +rt() : BelongsTo
    +hamlet() : BelongsTo
    +family() : BelongsTo
    +father() : BelongsTo
    +mother() : BelongsTo
    +childrenAsFather() : HasMany
    +childrenAsMother() : HasMany
    +socioeconomic() : HasOne
    +user() : HasOne
    +official() : HasOne
    note right
      *** PERUBAHAN BESAR v5.0 (Patch 41) ***
      Kolom no_kk DIHAPUS TOTAL (pindah ke
      Family.noKk).
      Tambah: familyId, familyRole, fatherId/
      motherId (SELF-REFERENCE - father()/
      mother() BelongsTo ke Citizen sendiri;
      childrenAsFather()/childrenAsMother()
      HasMany kebalikannya - untuk fitur pohon
      keluarga), fatherNameText/
      motherNameText (fallback teks bebas),
      bloodType, residencyType, originRegion,
      dataSource, lastVerifiedAt, syncStatus.
      socioeconomic(): HasOne ke
      CitizenSocioeconomic (1:1 per individu).
      ---
      TIDAK ADA kategori "warga Non-NIK" -
      setiap row di sini SUDAH PASTI punya
      NIK, baik lokal maupun pendatang.
      Pembeda murni residencyType, BUKAN
      model/tabel terpisah (SID-ARCH-BE-001
      S5.2).
      Gate akses tetap HANYA cek isActive -
      domicileStatus & residencyType murni
      informatif.
    end note
  }

  class Family {
    +id : bigint
    -noKk : string <<encrypted>>
    +noKkHash : string
    -familyAddress : string <<encrypted>>
    +familyStatus : enum
    +villageId : bigint
    +rtId : bigint?
    +hamletId : bigint?
    +headOfFamilyId : bigint?
    --
    +village() : BelongsTo
    +rt() : BelongsTo
    +hamlet() : BelongsTo
    +members() : HasMany
    +headOfFamily() : BelongsTo
    note right
      BARU v5.0. Tabel KK, sengaja TIPIS -
      hanya fakta level-keluarga. noKk/
      noKkHash: dual-column pola SAMA PERSIS
      dengan nik/nikHash (bukan pola baru).
      headOfFamily(): denormalisasi OPSIONAL
      untuk performa query - bisa diturunkan
      dari members().where('familyRole',
      'kepala_keluarga'). Jika dipakai,
      WAJIB dijaga konsisten manual.
    end note
  }

  class CitizenSocioeconomic {
    +id : bigint
    +citizenId : bigint
    +incomeRange : enum?
    +houseOwnershipStatus : enum?
    +waterSource : enum?
    +electricitySource : enum?
    +dependentsCount : int?
    +productiveAssets : json?
    +surveyedAt : datetime?
    +surveyedBy : bigint?
    --
    +citizen() : BelongsTo
    +surveyor() : BelongsTo
    note right
      BARU v5.0, MASUK MVP. Relasi 1:1
      dengan Citizen (per INDIVIDU, bukan
      per keluarga). Dipisah dari Citizen
      karena sering kosong (belum semua
      warga disurvei) dan butuh jejak waktu
      survei terpisah.
    end note
  }

  class Official {
    +id : bigint
    +citizenId : bigint
    +userId : bigint?
    +position : enum
    +villageId : bigint
    +rtId : bigint?
    +rwId : bigint?
    +hamletId : bigint?
    +signatureImg : string?
    +stampImg : string?
    +photoImg : string?
    +phoneWa : string?
    +startedAt : date
    +endedAt : date?
    +isActive : bool
    --
    +citizen() : BelongsTo
    +user() : BelongsTo
    +village() : BelongsTo
    +rt() : BelongsTo
    +rw() : BelongsTo
    +hamlet() : BelongsTo
    +isCurrentlyActive() : bool
    note right
      STRUKTUR ATRIBUT TIDAK BERUBAH dari
      v4.2. Perubahan MURNI di level
      MAKNA relasi: hamlet_id utk
      position='kadus' TETAP tersimpan
      (jabatan struktural non-approval
      masih ada), TAPI TIDAK LAGI dipakai
      OfficialService untuk resolve
      approval surat (lihat OfficialService
      di atas & FlowStep di bawah).
      position ENUM 14 nilai, TIDAK BERUBAH.
    end note
  }

  class LetterCategory {
    +id : bigint
    +code : enum
    +name : string
    +description : string?
    +handlerClass : string
    +isActive : bool
    --
    +flows() : HasMany
    +letterTypes() : HasMany
    note right
      BARU v5.0. code ENUM: approval_normal
      | upload_mandiri | dokumen_pendukung |
      update_data. Gate awal klasifikasi
      surat, jarang berubah. handlerClass
      -> pola Strategy: dispatch ke
      handler berdasarkan ini, bukan
      if/else bertingkat tersebar
      (SID-ARCH-BE-001 S3.4).
    end note
  }

  class ApprovalFlow {
    +id : bigint
    +categoryId : bigint
    +name : string
    +description : string?
    +isActive : bool
    --
    +category() : BelongsTo
    +steps() : HasMany
    +letterTypes() : HasMany
    +letters() : HasMany
    note right
      BARU v5.0. 1 category bisa punya
      BANYAK flow - flow baru = tambah
      row, BUKAN ubah kode (Config over
      Code, SID-ARCH-SYS-001 S1). Untuk
      category non-approval_normal, TETAP
      wajib punya 1 row flow (misal
      "Direct - Tanpa Approval Bertingkat")
      meski steps() kosong/minimal.
    end note
  }

  class FlowStep {
    +id : bigint
    +flowId : bigint
    +stepOrder : int
    +approverPosition : enum
    +isFinal : bool
    --
    +flow() : BelongsTo
    +approvals() : HasMany
    note right
      BARU v5.0. approverPosition ENUM:
      rt | kepala_desa | sekdes |
      kasi_pelayanan | kaur_tu_umum.
      *** 'rw' DAN 'kadus' TIDAK PERNAH
      MUNCUL di ENUM ini *** - keduanya
      TIDAK PERNAH menjadi gate approval
      formal (SID-ARCH-BE-001 S3.2).
      UNIQUE(flowId, stepOrder).
    end note
  }

  class LetterType {
    +id : bigint
    +code : string
    +name : string
    +template : string?
    +verificationType : enum
    +assignedRole : enum?
    +validityDays : int?
    +categoryId : bigint
    +flowId : bigint
    +isActive : bool
    --
    +category() : BelongsTo
    +flow() : BelongsTo
    +letters() : HasMany
    +isDraft() : bool
    +isPublishable() : bool
    note right
      Tambah categoryId (FK NOT NULL) &
      flowId (FK NOT NULL, BARU v5.0).
      assignedRole DIPERTAHANKAN sbg
      DERIVED CACHE utk kompatibilitas
      mundur - source of truth resmi soal
      approver adalah FlowStep.
      approverPosition. Policy WAJIB
      validasi lewat flow_steps, BUKAN
      assignedRole langsung, untuk cegah
      drift antar 2 sumber data
      (SID-ARCH-BE-001 S4.2).
    end note
  }

  class Letter {
    +id : bigint
    +villageId : bigint
    +letterTypeId : bigint
    +submittedBy : bigint
    +onBehalfOf : bigint?
    +citizenId : bigint?
    +letterNumber : string?
    +applicantName : string
    -applicantNik : string <<encrypted>>
    +applicantNikHash : string
    -applicantAddress : string? <<encrypted>>
    +purpose : string
    +status : enum
    +isOverdue : bool
    +expiresAt : datetime?
    +flowId : bigint
    +currentStepOrder : int
    +rejectedAtStep : int?
    +submittedAt : datetime
    +processedAt : datetime?
    --
    +village() : BelongsTo
    +letterType() : BelongsTo
    +flow() : BelongsTo
    +submitter() : BelongsTo
    +citizen() : BelongsTo
    +approvals() : HasMany
    +statusLogs() : HasMany
    +currentStep() : HasOneThrough
    +isDownloadable() : bool
    +isExpiredForWarga() : bool
    note right
      *** PERUBAHAN PALING BESAR v5.0 ***
      status: ENUM turun dari 9 nilai
      granular (v4.2: rt_approved,
      kadus_rejected, dst) MENJADI 4 nilai
      GENERIK: pending | in_progress |
      approved | rejected.
      Tambah: flowId (SNAPSHOT dari
      letterType.flowId saat submit,
      DIKUNCI - bukan live-reference),
      currentStepOrder (step aktif,
      dicocokkan ke flow_steps),
      rejectedAtStep (histori step
      penolakan).
      currentStep(): akses ke FlowStep
      yang sedang aktif via JOIN
      flowId+currentStepOrder - inilah
      cara sistem tahu "sedang di step
      mana", BUKAN dari nama status lagi.
      Blockchain hashing (Next Dev) - TIDAK
      ada model/relasi terkait hash di
      layer ini, TIDAK BERUBAH dari v4.2.
    end note
  }

  class LetterApproval {
    +id : bigint
    +letterId : bigint
    +approvedBy : bigint
    +approvalLevel : enum
    +action : enum
    +flowStepId : bigint?
    +notes : string?
    +deadlineAt : datetime?
    +remindedAt : datetime?
    --
    +letter() : BelongsTo
    +approver() : BelongsTo
    +flowStep() : BelongsTo
    +isOverdue() : bool
    note right
      approvalLevel ENUM turun dari 4 nilai
      (rt,rw,kadus,kasi) MENJADI 5 nilai
      (rt, kepala_desa, sekdes,
      kasi_pelayanan, kaur_tu_umum).
      'rw' DAN 'kadus' DIHAPUS - keduanya
      TIDAK PERNAH membuat row di sini
      sejak v5.0.
      Tambah flowStepId (BARU v5.0, FK
      nullable) - audit trail granular ke
      step spesifik yang dieksekusi.
      Jumlah record per letter kini
      DINAMIS mengikuti jumlah FlowStep
      milik flow surat ybs (TIDAK LAGI
      pasti "hingga 4" seperti v4.2).
    end note
  }

  class LetterStatusLog {
    +id : bigint
    +letterId : bigint
    +actorId : bigint
    +oldStatus : enum?
    +newStatus : enum
    +notes : string?
    +ipAddress : string?
    +userAgent : string?
    --
    +letter() : BelongsTo
    +actor() : BelongsTo
    note right
      oldStatus/newStatus ENUM ikut turun
      ke 4 nilai generik, selaras
      Letter.status.
    end note
  }

  class ApprovalSetting {
    +id : bigint
    +villageId : bigint
    +approvalLevel : enum
    +deadlineHours : int
    +reminderHours : int
    +isActive : bool
    --
    +village() : BelongsTo
    note right
      ⚠ approvalLevel ENUM MASIH peninggalan
      v4.2 ('rt','rw','kadus','kasi') - BELUM
      di-patch eksplisit oleh Patch Guide
      v5.0, TIDAK selaras dengan
      LetterApproval.approvalLevel. Digambar
      apa adanya sesuai TDD (technical debt,
      TDD Table 70 & Section 8.3.2).
    end note
  }
}

