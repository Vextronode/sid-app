    +code : string
    +name : string
    +template : string?
    +verificationType : enum
    +assignedRole : enum?
    +validityDays : int?
    +categoryId : bigint
    +flowId : bigint
    +isActive : bool
    --
    +category() : BelongsTo
    +flow() : BelongsTo
    +letters() : HasMany
    +isDraft() : bool
    +isPublishable() : bool
