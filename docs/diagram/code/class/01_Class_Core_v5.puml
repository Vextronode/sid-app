package "Repository Layer" #C8E6C9 {

  class UserRepository {
    +findByUsername(username) : User
    +findByIdWithCitizen(id) : User
    +findByCitizenId(citizenId) : User
    +create(data) : User
    +createNotificationBroadcast(data) : void
  }

  class CitizenRepository {
    +findByNikHash(nikHash) : Citizen
    +create(data) : Citizen
    +bulkInsert(rows) : int
  }

  class FamilyRepository {
    +findByNoKkHash(noKkHash) : Family
    +create(data) : Family
    +findMembersByFamilyId(familyId) : Collection
    note right
      BARU v5.0.
    end note
  }

  class OfficialRepository {
    +findActiveByUserId(userId, position) : Official
    +findActiveByRtId(rtId) : Official
    +findActiveByRwId(rwId) : Official
    +findActiveByPosition(position) : Collection
    +createNotification(data) : Notification
    note right
      findActiveByHamletId() (v4.2, utk
      resolve Kadus approval) DIHAPUS -
      tidak ada lagi kebutuhan resolve
      Kadus untuk konteks approval.
      findActiveByPosition() kini
      mengembalikan Collection (bisa >1
      pejabat aktif, relevan utk step
      kepala_desa/sekdes yang saling
      menggantikan - lihat
      SID-ARCH-BE-001 S3.2).
    end note
  }

  class LetterRepository {
    +findById(id) : Letter
    +findByIdWithRelations(id) : Letter
    +findByIdWithApprovals(id) : Letter
    +findByRtIdAndStatus(rtId, status) : Collection
    +queryPendingAtFlowStepPositions(positions, villageId, exceptUserId) : Builder
    +create(data) : Letter
    +update(letter, data) : Letter
    +createApprovalForLetter(letter, data) : LetterApproval
    +recordDecisionForLetter(letter, data) : LetterApproval
    +createStatusLog(data) : LetterStatusLog
    note right
      *** PERUBAHAN UTAMA v5.0 ***
      findByRwIdAndStatus(), findByHamletIdAndStatus(),
      findByAssignedRoleAndStatus() SEMUA DIHAPUS.
      Digantikan SATU method generik
      findByFlowStepAndStatus(approverPosition, status):
        SELECT l.* FROM letters l
        JOIN flow_steps fs ON fs.flow_id = l.flow_id
          AND fs.step_order = l.current_step_order
        WHERE fs.approver_position = ?
          AND l.status IN ('pending','in_progress')
      Method ini dipakai LINTAS Service (dashboard,
      notifikasi; reminder scheduler masih rancangan target) - inilah alasan
      Repository dipertahankan meski proyek capstone
      (SID-ARCH-BE-001 S2), untuk mencegah query
      terduplikasi di banyak Service.
      findByRtIdAndStatus() TETAP TERPISAH karena RT
      butuh JOIN tambahan ke citizens.rt_id (berbasis
      wilayah, bukan posisi murni).
    end note
  }

  class LetterTypeRepository {
    +findAllActive() : Collection
    +findById(id) : LetterType
  }

  class LetterCategoryRepository {
    +findByCode(code) : LetterCategory
    +findAllActive() : Collection
    note right
      BARU v5.0.
    end note
  }

  class ApprovalFlowRepository {
    +findById(id) : ApprovalFlow
    +findWithSteps(id) : ApprovalFlow
    +findByCategoryId(categoryId) : Collection
    note right
      BARU v5.0. findWithSteps() eager-load
      flow_steps terurut step_order - dipakai
      LetterService saat submit surat (snapshot
      flow_id) dan saat validasi gate step.
    end note
  }

  class HamletRepository { }
  class RtRepository { }
  class RwRepository { }

  class ApprovalSettingRepository {
    +findByVillageAndLevel(villageId, level) : ApprovalSetting
  }
}

