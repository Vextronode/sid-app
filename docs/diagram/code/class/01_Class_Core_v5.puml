package "Eloquent Model Layer" #FDE8D8 {

  class Village {
    +id : bigint
    +name : string
    +code : string
    +headName : string
    +stampImg : string?
    --
    +hamlets() : HasMany
    +users() : HasMany
    +citizens() : HasMany
    +families() : HasMany
    +officials() : HasMany
    +occupations() : HasMany
    +letters() : HasMany
  }

  class Hamlet {
    +id : bigint
    +villageId : bigint
    +name : string
    +code : string
    +isActive : bool
    --
    +village() : BelongsTo
    +rws() : HasMany
    +officials() : HasMany
    +citizens() : HasMany
  }

  class Rw {
    +id : bigint
    +hamletId : bigint
    +number : string
    +fullLabel : string
    +isActive : bool
    --
    +hamlet() : BelongsTo
    +rts() : HasMany
    +officials() : HasMany
  }

  class Rt {
    +id : bigint
    +rwId : bigint
    +number : string
    +fullLabel : string
    +isActive : bool
    --
    +rw() : BelongsTo
    +citizens() : HasMany
    +officials() : HasMany
  }

  class User {
    +id : uuid
    +villageId : uuid
    +citizenId : uuid?
    +name : string
    +username : string
    +email : string
    -password : string
    +role : enum
    +isActive : bool
    +mustChangePassword : bool
    --
    +village() : BelongsTo
    +citizen() : BelongsTo
    +official() : HasOne
    +submittedLetters() : HasMany
    +approvals() : HasMany
    note right
      role ENUM TETAP 9 nilai (TIDAK
      BERUBAH dari v4.2): warga, rt, rw,
      kadus, kasi_pelayanan, kaur_tu_umum,
      petugas_desa, kepala_desa,
      sekretaris_desa.
    end note
  }

  class Citizen {
    +id : uuid
    +villageId : bigint
    -nik : string <<encrypted>>
    +nikHash : string
    +name : string
    +gender : enum
    -address : string <<encrypted>>
    +rtId : bigint?
    +hamletId : bigint?
    +domicileStatus : enum
    +currentDomicile : string?
    +familyId : bigint?
    +familyRole : enum?
    +occupationId : bigint?
    +fatherId : bigint?
    +motherId : bigint?
    +fatherNameText : string?
    +motherNameText : string?
    +bloodType : enum?
    +residencyType : enum
    +originRegion : string?
    +dataSource : enum
    +lastVerifiedAt : datetime?
    +syncStatus : enum?
    +isActive : bool
    --
    +village() : BelongsTo
    +rt() : BelongsTo
    +hamlet() : BelongsTo
    +family() : BelongsTo
    +father() : BelongsTo
    +mother() : BelongsTo
    +occupation() : BelongsTo
    +childrenAsFather() : HasMany
    +childrenAsMother() : HasMany
    +user() : HasOne
    +official() : HasOne
    note right
      *** PERUBAHAN BESAR v5.0 (Patch 41) ***
      Kolom no_kk DIHAPUS TOTAL (pindah ke
      Family.noKk).
      Tambah: familyId, familyRole, fatherId/
      motherId (SELF-REFERENCE - father()/
      mother() BelongsTo ke Citizen sendiri;
      childrenAsFather()/childrenAsMother()
      HasMany kebalikannya - untuk fitur pohon
      keluarga), fatherNameText/
      motherNameText (fallback teks bebas),
      bloodType, residencyType, originRegion,
      dataSource, lastVerifiedAt, syncStatus.
      ---
      TIDAK ADA kategori "warga Non-NIK" -
      setiap row di sini SUDAH PASTI punya
      NIK, baik lokal maupun pendatang.
      Pembeda murni residencyType, BUKAN
      model/tabel terpisah (SID-ARCH-BE-001
      S5.2).
      Gate akses tetap HANYA cek isActive -
      domicileStatus & residencyType murni
      informatif.
    end note
  }

  class Family {
    +id : bigint
    -noKk : string <<encrypted>>
    +noKkHash : string
    -familyAddress : string <<encrypted>>
    +familyStatus : enum
    +villageId : bigint
    +rtId : bigint?
    +hamletId : bigint?
    +headOfFamilyId : bigint?
    --
    +village() : BelongsTo
    +rt() : BelongsTo
    +hamlet() : BelongsTo
    +members() : HasMany
    +headOfFamily() : BelongsTo
    +socioeconomics() : HasOne
    note right
      BARU v5.0. Tabel KK, sengaja TIPIS -
      hanya fakta level-keluarga. noKk/
      noKkHash: dual-column pola SAMA PERSIS
      dengan nik/nikHash (bukan pola baru).
      headOfFamily(): denormalisasi OPSIONAL
      untuk performa query - bisa diturunkan
      dari members().where('familyRole',
      'kepala_keluarga'). Jika dipakai,
      WAJIB dijaga konsisten manual.
    end note
  }

  class FamilySocioeconomic {
    +id : bigint
    +familyId : uuid
    +householdIncomeRange : enum?
    +houseOwnershipStatus : enum?
    +waterSource : enum?
    +electricitySource : enum?
    +dependentsCount : int?
    +productiveAssets : json?
    +surveyedAt : datetime?
    +surveyedBy : bigint?
    --
    +family() : BelongsTo
    +surveyor() : BelongsTo
    note right
      Data sosio-ekonomi per KK, relasi
      1:1 opsional ke Family. Survei ulang
      menimpa data sebelumnya.
    end note
  }

  class Occupation {
    +id : bigint
    +villageId : uuid
    +name : string
    +isActive : bool
    +sortOrder : int
    --
    +village() : BelongsTo
    +citizens() : HasMany
  }

  class Official {
    +id : bigint
    +citizenId : uuid
    +userId : uuid?
    +position : enum
    +villageId : bigint
    +rtId : bigint?
    +rwId : bigint?
    +hamletId : bigint?
    +signatureImg : string? <<private storage>>
    +stampImg : string? <<legacy, not used by PDF>>
    +photoImg : string?
    +phoneWa : string?
    +startedAt : date
    +endedAt : date?
    +termEndsAt : date?
    +isActive : bool
    --
    +citizen() : BelongsTo
    +user() : BelongsTo
    +village() : BelongsTo
    +rt() : BelongsTo
    +rw() : BelongsTo
    +hamlet() : BelongsTo
    +isCurrentlyActive() : bool
    note right
      STRUKTUR ATRIBUT TIDAK BERUBAH dari
      v4.2. Perubahan MURNI di level
      MAKNA relasi: hamlet_id utk
      position='kadus' TETAP tersimpan
      (jabatan struktural non-approval
      masih ada), TAPI TIDAK LAGI dipakai
      OfficialService untuk resolve
      approval surat (lihat OfficialService
      di atas & FlowStep di bawah).
      position ENUM 14 nilai, TIDAK BERUBAH.
    end note
  }

  class LetterCategory {
    +id : bigint
    +code : enum
    +name : string
    +description : string?
    +handlerClass : string
    +isActive : bool
    --
    +flows() : HasMany
    +letterTypes() : HasMany
    note right
      BARU v5.0. code ENUM: approval_normal
      | upload_mandiri | dokumen_pendukung |
      update_data. Gate awal klasifikasi
      surat, jarang berubah. handlerClass
      -> pola Strategy: dispatch ke
      handler berdasarkan ini, bukan
      if/else bertingkat tersebar
      (SID-ARCH-BE-001 S3.4).
    end note
  }

  class ApprovalFlow {
    +id : bigint
    +categoryId : bigint
    +name : string
    +description : string?
    +isActive : bool
    --
    +category() : BelongsTo
    +steps() : HasMany
    +letterTypes() : HasMany
    +letters() : HasMany
    note right
      BARU v5.0. 1 category bisa punya
      BANYAK flow - flow baru = tambah
      row, BUKAN ubah kode (Config over
      Code, SID-ARCH-SYS-001 S1). Untuk
      category non-approval_normal, TETAP
      wajib punya 1 row flow (misal
      "Direct - Tanpa Approval Bertingkat")
      meski steps() kosong/minimal.
    end note
  }

  class FlowStep {
    +id : bigint
    +flowId : bigint
    +stepOrder : int
    +approverPosition : enum
    +isFinal : bool
