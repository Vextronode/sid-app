package "Service Layer" #D5EAD0 {

  class AuthService {
    +registerWarga(data) : User
    +attemptLogin(credentials) : User
    -hashNik(nik) : string
  }

  class LetterService {
    +createLetter(data) : Letter
    +getScopedLetters(user, filters) : Collection
    +getForShow(id) : Letter
    +delete(letter, user) : bool
    note right
      Daftar bersama menerapkan scope role:
      RT, RW, Kadus, Kades/Sekdes, Kasi/Kaur,
      Petugas Desa, dan scope=mine.
      Keputusan tidak diproses di sini.
    end note
  }

  class RtApprovalService {
    +decision(letter, user, data) : void
  }

  class KadesApprovalService {
    +decision(letter, user, data) : void
  }

  class LetterFlowService {
    +submit(data, user) : Letter
    +processRtDecision(letter, action, actor) : Letter
    +processFinalDecision(letter, action, actor) : Letter
    +resolveInitialStep(flow, applicant) : int
  }

  class LetterNumberGenerator {
    +generate(letter) : string
    +nextNumber(villageId, letterTypeId, year) : int
  }

  class ProfileService {
    +update(user, data) : User
    +changePassword(user, data) : User
  }

  class OfficialAssignmentService {
    +promote(actor, data) : Official
    +demote(actor, official, notes) : array
    +rotate(actor, official, data) : array
    +bootstrapFirstPetugas(target: User) : User
    note right
      Promosikan akun warga aktif yang sudah ada secara transaksional;
      buat official Petugas Desa dan catat activitylog.
    end note
  }

  class OfficialService {
    +resolveRtForCitizen(citizen) : Official
    +resolveRwForCitizen(citizen) : Official
    +resolveByPositionOnly(position) : Collection
    +isOfficialAuthorized(userId, position) : bool
    +isOfficialAuthorized(userId, letterId, position) : bool
    note right
      *** PERUBAHAN v5.0 ***
      resolveKadusForCitizen() DIHAPUS -
      Kadus tidak lagi target resolve utk
      approval surat.
      resolveRwForCitizen() TETAP ADA tapi
      TURUN LEVEL: dari "resolve approver
      dengan gate otorisasi" (v4.2) menjadi
      "resolve NOTIFIER FYI saja" (v5.0) -
      tidak ada pengecekan otorisasi approve
      untuk hasil resolve ini, karena RW
      tidak pernah memanggil endpoint
      decision/approval.
      resolveByPositionOnly() BARU - generik
      untuk Kepala Desa/Sekdes,
      resolve via officials.position IN (...)
      + is_active=true, TANPA join wilayah
      sama sekali (SID-ARCH-BE-001 S3.2).
    end note
  }

  class CitizenService {
    +importFromExcel(file) : ImportResult
    +findByNikHash(nikHash) : Citizen
    +validateNikUniqueness(nik) : bool
    note right
      Sesuai UC-09/SID-ARCH-BE-001 S5.3:
      HANYA Petugas Desa yang boleh
      create/update citizens. Tidak ada
      mekanisme warga edit data sendiri
      (Human-in-the-Loop principle).
    end note
  }

  class FamilyService {
    +createFamily(data) : Family
    +addMember(familyId, citizenData) : Citizen
    -guardSingleHeadOfFamily(familyId) : void
    note right
      BARU v5.0. guardSingleHeadOfFamily():
      validasi hanya 1 family_role=
      'kepala_keluarga' per family_id aktif.
      Service ini TIDAK BOLEH menyalin data
      KK ke citizens atau sebaliknya sebagai
      denormalisasi tambahan di luar
      families.head_of_family_id yang memang
      sudah didefinisikan sebagai
      denormalisasi opsional terjaga manual
      (SID-ARCH-BE-001 S5.1).
    end note
  }

  class HamletService { +create(data, user) : Hamlet }
  class RtService { +create(data, user) : Rt }
  class RwService { +create(data, user) : Rw }

  class PdfService {
    +generateLetterPdf(letterId) : string
    -checkExpiryForWarga(letter, user) : bool
    -getActiveKadesSignature() : Official
    note right
      On-demand generation, TIDAK BERUBAH
      dari v4.0. Gate akses: warga dicek
      expires_at, role lain (Petugas Desa,
      Kasi/Kaur, Kades, Sekdes) selalu
      bisa generate (SID-ARCH-BE-001 S6).
    end note
  }

}

