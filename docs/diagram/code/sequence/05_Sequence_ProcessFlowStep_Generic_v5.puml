'==================================================================================
' SECTION: SEQUENCE DIAGRAM
' FILE: 05_Sequence_ProcessFlowStep_Generic_v5.puml
' JUDUL: Sequence - Process Flow Step (Generic Approval)
' SUMBER: TDD SID Desa Cibenda v5.1 (Section 5.3.2 UC-04c,
'         Section 5.3.3 daftar sequence diagram)
'         + SID-ARCH-BE-001 S3.2, S3.3, S4.3 + SID-ARCH-FE-001 S6
' CATATAN: Memodelkan approval tahap Kades/Sekdes. Kasi/Kaur hanya
'          menerima notifikasi final dan akses baca/unduh, bukan approver.
'==================================================================================

@startuml 5.3.3e_v5 Sequence - Process Flow Step Generic Approval
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ParticipantBackgroundColor #EBF3FB
  ParticipantBorderColor #2E5FA3
  ParticipantFontName Arial
  ParticipantFontSize 12
  ActorBackgroundColor #D6E4F7
  ActorBorderColor #1F3864
  ActorFontName Arial
  LifeLineBorderColor #2E5FA3
  ArrowColor #2E5FA3
  ArrowFontName Arial
  ArrowFontSize 11
  NoteBackgroundColor #FFF9C4
  NoteBorderColor #F9A825
}

title Sequence Diagram - Persetujuan Kepala Desa/Sekdes [v5.1] \n(UC-04c - Finalisasi di Step Final; Kasi/Kaur Read-only Setelah Disetujui)

actor "Kepala Desa / Sekdes" as APPR
participant "React\nFrontend\n(ApprovalStepRenderer)" as FE
participant "LetterController" as LCTRL
participant "KadesApprovalController" as CTRL
participant "Policy\n(Authorization)" as POL
participant "LetterService" as LSVC
participant "Form\nRequest" as FREQ
participant "KadesApprovalService" as SVC
participant "OfficialService" as OSVC
participant "LetterRepository" as REPO
participant "ApprovalFlowRepository" as AFREPO
participant "OfficialRepository" as OREPO
participant "DB::transaction" as TX
participant "Notification database channel" as Q
participant "PostgreSQL" as DB
actor "Approver Berikutnya\n(Jika Ada Step Lanjutan)" as NEXT
actor "Warga\n(Pemohon)" as WRG
actor "Kasi Pelayanan / Kaur TU Umum\n(Notifikasi + Baca/Unduh)" as KASI

note over APPR, KASI
  Kades atau Sekdes memutuskan step final berposisi
  kepala_desa (first-action-wins). Kasi/Kaur bukan
  approver: keduanya hanya menerima notifikasi setelah
  surat approved dan dapat membaca/mengunduh sesuai
  letter_types.assigned_role.
end note

== Lihat Daftar Surat Desa ==

APPR -> FE : Buka dashboard / menu "Surat Masuk"
FE -> LCTRL : GET /api/letters
LCTRL -> POL : authorize('viewAny', Letter::class)
POL --> LCTRL : allowed
LCTRL -> LSVC : getScopedLetters(user, filters)
LSVC -> OSVC : getCurrentOfficial(user)
OSVC -> OREPO : cari pejabat aktif user
OREPO -> DB : SELECT official dan village_id
DB --> OREPO : official aktif
OREPO --> OSVC : official aktif
OSVC --> LSVC : official aktif
LSVC -> REPO : queryRtApprovedInVillage(village_id)
REPO -> DB : SELECT surat di desa\nyang disetujui RT atau mencatat\nskip tahap RT
DB --> REPO : surat lintas tahap berikutnya
REPO --> LSVC : collection surat
LSVC --> LCTRL : LetterCollection
LCTRL --> FE : 200 OK {data: [...]}
FE --> APPR : Tampilkan surat yang lolos\nscope desa; keputusan hanya\nsaat step kepala_desa aktif

== Buka & Periksa Detail Surat ==

APPR -> FE : Klik salah satu surat
FE -> LCTRL : GET /api/letters/{id}
LCTRL -> LSVC : getForShow(id)
LSVC -> REPO : findWithApprovalActorForShow(id)
REPO -> DB : SELECT surat dan relasi detail
DB --> REPO : letter detail
REPO --> LSVC : letter
LSVC --> LCTRL : letter
LCTRL -> POL : authorize('view', letter)

alt Surat bukan milik/desa yang berwenang
  POL --> LCTRL : denied
  LCTRL --> FE : 403 Forbidden
  FE --> APPR : Tampilkan pesan error
else Surat dapat dilihat
  POL --> LCTRL : allowed
  LCTRL --> FE : 200 OK {data: LetterResource}
  FE --> APPR : Tampilkan detail dan riwayat\nsurat yang boleh diakses
  note right of FE
    Tombol keputusan hanya tersedia bagi
    Kades/Sekdes pada step kepala_desa aktif.
  end note
end

== Berikan Keputusan ==

APPR -> FE : Klik "Setujui" atau "Tolak",\nisi catatan jika menolak
FE -> CTRL : PATCH /api/kades/letters/{letter}/decision\n{status: "approved"|"rejected", notes}
CTRL -> FREQ : validate(request)

alt Memilih "Tolak" tanpa catatan
  FREQ --> CTRL : ValidationException
  CTRL --> FE : 422 {error: "Catatan wajib\ndiisi jika menolak"}
  FE --> APPR : Tampilkan pesan error

else Validasi lolos
  FREQ --> CTRL : validated data
  CTRL -> SVC : decision(letter, user, validated data)
  SVC -> OSVC : authorizeOfficial(user)
  OSVC --> SVC : active Kades/Sekdes official
  SVC -> SVC : verify same village and\nnot the letter applicant
  SVC -> REPO : findCurrentFlowStep(letter)
  REPO -> DB : SELECT letters.*, flow_steps.*\nFROM letters JOIN flow_steps\nON flow_steps.flow_id = letters.flow_id\nAND flow_steps.step_order = letters.current_step_order\nWHERE letters.id = ?
  DB --> REPO : letter + step aktif
  REPO --> SVC : letter + active flow step

  alt step bukan posisi kepala_desa
    SVC --> CTRL : 409 Conflict
    CTRL --> FE : 409 {error: "Surat ini tidak sedang\nberada di tahap Kepala Desa/Sekdes."}
    FE --> APPR : Tampilkan pesan error
  else step kepala_desa aktif

    == GATE LOGIC (Re-validasi, First-Action-Wins jika Kades/Sekdes) ==

    SVC -> TX : DB::transaction() begin
    TX -> REPO : findForUpdateOrFail(letter.id)
    REPO -> DB : SELECT * FROM letters\nWHERE id = ? FOR UPDATE
    DB --> REPO : locked letter
    TX -> REPO : findCurrentFlowStep(locked)
    REPO -> DB : SELECT active flow step
    DB --> REPO : locked letter's current step
    REPO --> SVC : locked letter + current step

    alt Step sudah berpindah saat submit keputusan
      note right of SVC
        Double-check gate logic: status/
        current_step_order bisa berubah
        antara buka halaman & submit
        keputusan.
        *** First-Action-Wins (Kepala
        Desa/Sekdes) - SID-ARCH-BE-001
        S3.3 *** : step aktif harus
        berposisi 'kepala_desa'; Kades
        dan Sekdes sama-sama berwenang
        memutuskan step itu. Service
        mengunci row surat, memeriksa ulang
        status pending/in_progress dan ID
        step aktif. Request yang terlambat
        setelah keputusan pertama mendapat
        409, termasuk bila surat terminal.
      end note
      SVC --> CTRL : HTTP 409 Conflict (abort)
      CTRL --> FE : 409 {error: "Surat sudah diproses\n(kemungkinan oleh Kades/Sekdes\nyang lain, atau step berpindah)"}
      FE --> APPR : Tampilkan pesan error status konflik

    else Step masih valid untuk diproses
      SVC -> AFREPO : findWithSteps(letter.flow_id)
      AFREPO -> DB : SELECT * FROM flow_steps\nWHERE flow_id = ?\nORDER BY step_order
      DB --> AFREPO : seluruh steps milik flow ini
      AFREPO --> SVC : Collection<FlowStep>

      SVC -> SVC : currentStep = steps.firstWhere(\n  'step_order', letter.current_step_order)
      SVC -> SVC : isFinal = currentStep.is_final

      alt action = "approved"

        alt currentStep.is_final = true
          TX -> SVC : finalizeApproval(letter)
          SVC -> SVC : generate letter_number\nand calculate expires_at

          TX -> REPO : update(letter, {\n  status: 'approved',        <<GENERIK, step final>>\n  letter_number: generated,\n  expires_at: calculated,\n  processed_at: now()\n})
          REPO -> DB : UPDATE letters\nSET status = 'approved',\nletter_number = ?, expires_at = ?,\nprocessed_at = now()
          DB --> REPO : updated
          note right of DB
            current_step_order TIDAK
            di-increment lagi di step
            final - tidak ada step
            berikutnya.
          end note

        else currentStep.is_final = false
          TX -> SVC : nextActionable(letter, currentStep.step_order)
          SVC -> AFREPO : findWithSteps(letter.flow_id)
          AFREPO -> DB : SELECT ordered flow steps\nafter current step
          DB --> AFREPO : following steps
          AFREPO --> SVC : flow steps
          SVC -> SVC : apply applicant-official skip rules;\nfinal step is never skipped
          SVC --> TX : next step + skipped[]
          TX -> REPO : update(letter, {\n  status: 'in_progress',\n  current_step_order: next.step_order,\n  processed_at: now()\n})
          REPO -> DB : UPDATE letters\nSET status = 'in_progress',\n          current_step_order = next.step_order,\nprocessed_at = now()
          DB --> REPO : updated
          TX -> SVC : logSkipped(next.skipped)
        end

        TX -> REPO : recordDecisionForLetter({actor, actual approval_level, action: 'approved', flow_step_id: currentStep.id})
        REPO -> DB : UPDATE pending letter_approvals row (decision fields)
        note right of DB
          Jumlah record letter_approvals kini
          DINAMIS sesuai jumlah step di flow
          surat ini - TIDAK LAGI selalu
          "hingga 4" seperti asumsi v4.2.
        end note
        DB --> REPO : decision recorded; no pending row remains for this step

        TX -> REPO : createStatusLog({\n  letter_id, actor_id: auth()->id(),\n          old_status: oldStatus,\n  new_status: [approved|in_progress],\n  ip_address\n})
        REPO -> DB : INSERT INTO letter_status_logs
        DB --> REPO : log created

        TX -> SVC : continue transaction; process notification

        alt currentStep.is_final = true
          SVC -> Q : notify(new LetterStatusNotification(...))
          Q -> REPO : createNotification({\n  notifiable_id: warga.user_id,\n  data: {letter_id, letter_number}\n})
          REPO -> DB : INSERT INTO notifications
          DB --> REPO : notification created
          Q --> WRG : Notifikasi database:\n"Permohonan surat Anda disetujui!\nNomor Surat: [letter_number]"

          SVC -> OSVC : resolveKasiKaurForLetter(letter)
          OSVC -> OREPO : resolve active officials by assigned_role
          OREPO -> DB : SELECT eligible Kasi/Kaur officials
          DB --> OREPO : eligible officials
          OREPO --> OSVC : officials
          OSVC --> SVC : officials
          SVC -> Q : notify officials that letter is ready
          Q --> KASI : Notifikasi setelah final approval

        else isFinal = false (Step Lanjutan)
          TX -> REPO : createApprovalForLetter(next.step, approved_by: null, action: null, deadline_at)
          REPO -> DB : INSERT pending approval placeholder for next step
          SVC -> OSVC : eligibleApprovers(next.step, letter)
          note right of OSVC
            Pejabat aktif pada step berikutnya
            di-resolve menggunakan posisi dan
            scope yang dikonfigurasi. Kasi/Kaur
            bukan posisi approver yang valid.
          end note
          OSVC -> OREPO : resolve officials for next.step
          OREPO -> DB : SELECT active eligible officials\nfor configured position and scope
          DB --> OREPO : official(s) step berikutnya
          OREPO --> OSVC : Official(s)
          OSVC --> SVC : Official(s)

          SVC -> Q : dispatch(LetterStatusNotification ->\nApprover Berikutnya)
          Q -> OREPO : createNotification({\n  notifiable_id: [user_id approver\n  berikutnya],\n  data: {letter_id, pesan}\n})
          OREPO -> DB : INSERT INTO notifications
          DB --> OREPO : notification created
          Q --> NEXT : Notifikasi database:\n"Ada surat menunggu\npersetujuanmu"
        end

      else action = "rejected"
        TX -> REPO : update(letter, {\n  status: 'rejected',              <<GENERIK>>\n  rejected_at_step: currentStep.step_order,\n  processed_at: now()\n})
        REPO -> DB : UPDATE letters\nSET status = 'rejected',\nrejected_at_step = ?,\nprocessed_at = now()
        DB --> REPO : updated

        TX -> REPO : recordDecisionForLetter({actor, actual approval_level, action: 'rejected', flow_step_id: currentStep.id})
        REPO -> DB : UPDATE pending letter_approvals row (decision fields)
        DB --> REPO : decision recorded; no pending row remains for this step

        TX -> REPO : createStatusLog({\n  letter_id, actor_id: auth()->id(),\n          old_status: oldStatus,\n  new_status: 'rejected', ip_address\n})
        REPO -> DB : INSERT INTO letter_status_logs
        DB --> REPO : log created

        TX -> SVC : continue transaction; process notification

        SVC -> Q : notify(new LetterStatusNotification(...))
        Q -> REPO : createNotification({\n  notifiable_id: warga.user_id,\n  data: {letter_id, alasan}\n})
        REPO -> DB : INSERT INTO notifications
        DB --> REPO : notification created
        Q --> WRG : Notifikasi database:\n"Surat Anda ditolak\n- [catatan alasan]"
        note right of WRG
          Status FINAL: 'rejected' (TERMINAL),
          rejected_at_step dicatat = step_order
          saat ini. TIDAK ADA eskalasi ke
          step manapun setelah ini, terlepas
          dari step ini final atau bukan.
        end note
      end

      TX --> SVC : commit
      SVC --> CTRL : LetterResource (updated)
      CTRL --> FE : 200 OK\n{letter: {status, current_step_order,\nletter_number, expires_at\n(jika approved & final)}}
      FE --> APPR : Tampilkan konfirmasi keputusan,\nkembali ke daftar surat
    end
  end
end

@enduml

'==================================================================================
' CATATAN SINKRONISASI v5.1
' Diagram aktif di atas hanya memodelkan keputusan Kades/Sekdes.
' Kasi/Kaur bukan approver; finalisasi (nomor surat dan masa berlaku)
' terjadi pada step final Kades/Sekdes. Kasi/Kaur hanya menerima
' notifikasi dan akses baca/unduh setelah status surat approved.
' Keputusan approval memperbarui current_step_order ke nextActionable,
' bukan sekadar menambah angka satu.
'==================================================================================
