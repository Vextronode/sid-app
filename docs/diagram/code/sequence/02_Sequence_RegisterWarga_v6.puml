'==================================================================================
' SECTION: SEQUENCE DIAGRAM
' FILE: 02_Sequence_RegisterWarga_v6.puml
' JUDUL: Sequence - Register Warga (UC-17)
' SUMBER: routes/auth.php, RegisteredUserController, RegisterUserRequest,
'         Auth\AuthService::registerWarga, UsernameGenerator (2026-10-16)
' CATATAN: Menggantikan 02_Sequence_RegisterWarga_v5.puml (tambah tanggal lahir).
'==================================================================================
@startuml Sequence_RegisterWarga_v6
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ParticipantBackgroundColor #EBF3FB
  ParticipantBorderColor #2E5FA3
  ActorBackgroundColor #D6E4F7
  ArrowColor #2E5FA3
  ArrowFontSize 10
  NoteBackgroundColor #FFF9C4
  NoteBorderColor #F9A825
}
title Sequence - Register Warga [v6] (NIK + tanggal lahir + password)

actor "Calon Warga" as W
participant "React\n(RegisterPage)" as FE
participant "throttle:register\n(5/menit IP, 10/jam hash NIK)" as RL
participant "RegisteredUserController" as CTRL
participant "RegisterUserRequest" as REQ
participant "AuthService" as SVC
participant "UsernameGenerator" as UG
database "PostgreSQL" as DB

W -> FE : isi NIK, tanggal lahir, password, konfirmasi
FE -> FE : GET /sanctum/csrf-cookie
FE -> RL : POST /register
RL -> CTRL
CTRL -> REQ : validate (nik digits:16, date_of_birth date,\npassword confirmed)
CTRL -> SVC : registerWarga(data)
SVC -> DB : SELECT citizens WHERE nik_hash = sha256(nik)
alt NIK tidak ditemukan
  SVC --> FE : 422 nik "NIK tidak terdaftar ..."
else sudah punya akun
  SVC --> FE : 422 nik "NIK sudah terdaftar, silakan login"
else tanggal lahir != citizens.date_of_birth
  SVC --> FE : 422 date_of_birth "Tanggal lahir tidak sesuai dengan data kependudukan"
else valid
  SVC -> UG : generate(citizen.name)
  UG -> DB : cek usernameExists (ulang bila bentrok)
  SVC -> DB : INSERT users (role warga, aktif, village_id, citizen_id)
  CTRL -> CTRL : event Registered
  CTRL --> FE : 201 {data: {name, username}, message}
  note right of FE
    Register tidak membuat sesi;
    warga login dengan username.
  end note
end
@enduml
