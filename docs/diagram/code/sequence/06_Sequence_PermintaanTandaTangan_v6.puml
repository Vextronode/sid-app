'==================================================================================
' SECTION: SEQUENCE DIAGRAM
' FILE: 06_Sequence_PermintaanTandaTangan_v6.puml
' JUDUL: Sequence - Persetujuan Saksi (UC-25)
' SUMBER: SignatureRequestController, LetterSignatureController,
'         LetterSignatureService, LetterService::beginApprovalIfSigned (2026-10-31)
' CATATAN: FILE BARU v6. Revisi 2026-10-31: TTD digital (TTD akun, TTD basah
'          unggahan, reset TTD) dihapus; yang tersisa hanya persetujuan saksi
'          (termasuk persetujuan pasangan/kepala KK tujuan F09). Surat
'          ditandatangani dan distempel basah di kantor desa setelah terbit.
'==================================================================================
@startuml Sequence_TandaTangan_v6
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ParticipantBackgroundColor #EBF3FB
  ParticipantBorderColor #2E5FA3
  ActorBackgroundColor #D6E4F7
  ArrowColor #2E5FA3
  ArrowFontSize 10
  NoteBackgroundColor #FFF9C4
  NoteBorderColor #F9A825
}
title Sequence - Persetujuan Saksi [v6]

actor "Pemilik NIK (saksi)" as T
actor "Pemohon" as P
participant "React" as FE
participant "SignatureRequestController" as SRC
participant "LetterSignatureController" as LSC
participant "LetterSignatureService" as LSS
participant "LetterService" as LS
database "PostgreSQL" as DB

== Menanggapi permintaan saksi ==
FE -> SRC : GET /api/signature-requests
SRC -> LSS : pendingFor(user) (target_nik_hash, pending, belum kedaluwarsa)
alt setujui
  T -> FE : masukkan kata sandi
  FE -> SRC : POST /api/signature-requests/{id}/accept {password}
  SRC -> SRC : current_password (422 bila salah)
  SRC -> LSS : accept(request, user)
  LSS -> LSS : guardIsTarget (404) & isPending (409)
  LSS -> DB : UPDATE letter_signatures signed, signer_user_id
  LSS -> P : signature_accepted
  SRC -> LS : beginApprovalIfSigned(letter)
  LS -> DB : lock letter; semua saksi terisi?
  LS -> LS : startApproval → step awal, placeholder, notifikasi approver
else tolak
  FE -> SRC : POST /api/signature-requests/{id}/reject {notes?, block?}
  SRC -> LSS : reject(request, user, notes, block)
  LSS -> DB : UPDATE rejected (+ INSERT signature_blocks bila block)
  LSS -> P : signature_rejected (tanpa identitas penolak)
end

== Pemohon mengganti saksi ==
P -> FE : NIK saksi lain (+ nama bila di luar data penduduk)
FE -> LSC : POST /api/letters/{letter}/signatures/{slot} {nik, name?, family_number?}
LSC -> LSC : hanya pemohon (403); surat pending & step 0 (409)
LSC -> LSS : refillSlot() — batalkan pending lama (cancelled)
LSS -> DB : INSERT letter_signatures baru (consent | rt_check | manual)
LSC -> LS : beginApprovalIfSigned(letter)
LSC --> FE : 200 {LetterSignatureResource}
@enduml
