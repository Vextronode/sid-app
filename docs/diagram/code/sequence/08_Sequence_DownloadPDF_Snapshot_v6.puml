'==================================================================================
' SECTION: SEQUENCE DIAGRAM
' FILE: 08_Sequence_DownloadPDF_Snapshot_v6.puml
' JUDUL: Sequence - Unduh PDF Surat dari Snapshot (UC-08)
' SUMBER: LetterDownloadController, LetterPolicy::download, PdfService,
'         LetterSnapshotService, LetterSignatureService, LetterValueFormatter
' CATATAN: FILE BARU v6.
'==================================================================================
@startuml Sequence_DownloadPDF_v6
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ParticipantBackgroundColor #EBF3FB
  ParticipantBorderColor #2E5FA3
  ActorBackgroundColor #D6E4F7
  ArrowColor #2E5FA3
  ArrowFontSize 10
  NoteBackgroundColor #FFF9C4
  NoteBorderColor #F9A825
}
title Sequence - Unduh PDF Surat [v6] (on-demand dari snapshot)

actor "Pemohon / Petugas / Kades-Sekdes /\nKasi-Kaur (assigned_role)" as U
participant "React" as FE
participant "LetterDownloadController" as CTRL
participant "LetterPolicy::download" as POL
participant "PdfService" as PDF
participant "LetterSnapshotService" as SNAP
participant "LetterSignatureService" as SIG
participant "dompdf" as DOM
database "PostgreSQL" as DB

U -> FE : Unduh PDF
FE -> CTRL : GET /api/letters/{letter}/download?document=
CTRL -> POL : approved & (pemohon | desa sama sesuai role)
CTRL -> PDF : download(letter, user, document)
PDF -> PDF : pemohon & expires_at lewat → 403
PDF -> SNAP : contextFor(letter)
alt snapshot ada
  SNAP --> PDF : letters.snapshot
else surat approved lama
  SNAP -> DB : Kades aktif (404 bila tidak ada)
  SNAP -> DB : simpan snapshot + signed_by_official_id
end
PDF -> SIG : renderData(letter) (nama penanda tangan slot)
PDF -> PDF : ganti placeholder (escape nilai isian,\nformat tanggal/rupiah/terbilang);\nruang TTD/stempel dikosongkan
PDF -> DOM : loadView(pdf.templates.letter)
DOM --> FE : application/pdf (surat-{id}.pdf), tidak disimpan
note over U, DOM
  PDF tanpa TTD dan stempel. Surat resmi = cetakan yang ditandatangani
  dan distempel basah di kantor desa, diambil pemohon di sana.
end note
@enduml
