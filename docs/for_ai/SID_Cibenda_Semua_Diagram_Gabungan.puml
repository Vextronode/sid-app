note right of AFLOW
  BARU v5.0. Anak dari category, urutan
  step approval spesifik. 1 category bisa
  punya BANYAK flow (flow baru = tambah
  row, BUKAN ubah kode - Config over Code,
  SID-ARCH-SYS-001 S1). Untuk category
  upload_mandiri/dokumen_pendukung/
  update_data: TETAP WAJIB punya row di
  sini (misal flow "Direct - Tanpa
  Approval Bertingkat"), meski flow_steps-
  nya kosong/minimal - demi 1 pola query
  generik seragam.
end note

entity "flow_steps" as FSTEP {
  * id : BIGINT <<PK, AUTO INCREMENT>>
  --
  * flow_id : BIGINT <<FK -> approval_flows, NOT NULL>>
  * step_order : INT
  * approver_position : ENUM('rt','kepala_desa',\n'sekdes','kasi_pelayanan',\n'kaur_tu_umum')
  * is_final : BOOLEAN <<DEFAULT false>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

note right of FSTEP
  BARU v5.0. Urutan approver per flow.
  UNIQUE(flow_id, step_order).
  --
  *** PENTING (TDD & SID-ARCH-BE-001 S3.2) ***
  'rw' dan 'kadus' TIDAK PERNAH muncul
  sebagai approver_position di tabel ini:
  - RW: side-effect notifikasi FYI saja,
    bukan gate approval formal. Endpoint
    decision/approval TIDAK PERNAH dibuka
    untuk role RW di level route.
  - Kadus: dihapus total dari domain
    approval sejak v5.0.
  --
  Resolve approver 2 pola berbeda:
  - approver_position='rt' -> berbasis
    WILAYAH (citizens.rt_id -> rts.id,
    lalu officials aktif dg rt_id sama)
  - approver_position IN ('kepala_desa',
    'sekdes','kasi_pelayanan',
    'kaur_tu_umum') -> berbasis POSISI
    MURNI (officials.position + is_active,
    TANPA join wilayah sama sekali)
end note

entity "letter_types" as LT {
