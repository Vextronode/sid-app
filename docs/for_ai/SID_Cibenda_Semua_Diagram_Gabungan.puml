actor "Approver\n(Kepala Desa / Sekdes /\nKasi Pelayanan / Kaur TU Umum)" as APPR
participant "React\nFrontend\n(ApprovalStepRenderer)" as FE
participant "FlowStepApprovalController" as CTRL
participant "Policy\n(Authorization)" as POL
participant "Form\nRequest" as FREQ
participant "LetterService" as SVC
participant "OfficialService" as OSVC
participant "LetterRepository" as REPO
participant "ApprovalFlowRepository" as AFREPO
participant "OfficialRepository" as OREPO
participant "DB::transaction" as TX
participant "Queue\n(Jobs)" as Q
participant "PostgreSQL" as DB
actor "Approver Berikutnya\n(Jika Ada Step Lanjutan)" as NEXT
