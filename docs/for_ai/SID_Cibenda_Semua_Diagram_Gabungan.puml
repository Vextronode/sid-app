  phone : VARCHAR(20)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "hamlets" as HAM {
  * id : BIGINT <<PK>>
  --
  * village_id : BIGINT <<FK -> villages>>
  * name : VARCHAR(100)
  * code : VARCHAR(20) <<UNIQUE>>
  * is_active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

note right of HAM
  TIDAK BERUBAH dari v4.2/v6.
  5 Dusun Desa Cibenda: Patrol,
  Sinargalih, Cibenda, Budiasih, Sucen
  (di-seed saat instalasi).
end note

entity "rws" as RWS {
