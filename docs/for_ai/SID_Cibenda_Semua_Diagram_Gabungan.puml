  }

  rectangle "fail2ban" #FFE0B2 {
    component "Monitor: SSH brute-force\n+ Login endpoint brute-force" as FAIL2BAN
  }

  rectangle "Web Server Layer" #D5EAD0 {
    component "Nginx\n(Reverse Proxy + Static Files)" as NGINX
    component "TLS 1.2 / 1.3\n(HTTPS Certificate)" as TLS
    note bottom of NGINX
      Directory listing DISABLED.
      Force HTTPS redirect aktif
      di level Nginx + Laravel
      (AppServiceProvider).
      TIDAK BERUBAH dari v4.2.
    end note
  }

  rectangle "Application Layer" #C8E6C9 {
    component "PHP-FPM\n(PHP 8.3)" as PHPFPM
    component "Laravel REST API\n(app/)\n- Pipeline Approval Dinamis v5.0" as LARAVEL
    note bottom of LARAVEL
      PHP error display DISABLED
      di production. Logging ke
      file (storage/logs).
      v5.0: business logic pipeline
      approval kini config-driven
      (letter_categories/approval_flows/
      flow_steps) - TIDAK menambah
      requirement infrastruktur apapun,
      murni perubahan level aplikasi.
    end note
  }

  rectangle "React SPA (Build Static)" #A5D6A7 {
    component "dist/ atau build/\n(Served via Nginx)" as REACTBUILD
  }

  rectangle "Background Processing" #81C784 {
    component "Supervisor" as SUPERVISOR
    component "Queue Worker\n(php artisan queue:work)" as QWORKER
    component "Laravel Scheduler\n(Cron: * * * * *\nphp artisan schedule:run)" as SCHEDULER
    note bottom of SUPERVISOR
      Queue worker HARUS selalu aktif -
      Supervisor auto-restart jika worker
      crash/mati. Jobs yang berjalan:
      SendNotificationJob (GENERIK v5.0 -
      menerima approverPosition sebagai
      parameter, menggantikan asumsi job
      terpisah per posisi),
      SendApprovalReminderJob (via
      scheduler, setiap jam).
      Queue driver: database (Tahap 1),
      BUKAN Redis (Redis = Tahap 2).
      TIDAK ADA GenerateLetterHashJob
      (blockchain = Next Dev Paket 2).
    end note
  }

  rectangle "PDF Generation (On-Demand)" #B2DFDB {
    component "barryvdh/laravel-dompdf" as DOMPDF
    note bottom of DOMPDF
      Tidak ada storage khusus -
      PDF digenerate saat request,
      langsung di-stream sebagai
      response, tidak disimpan
