@startuml
title SID - POV RT/RW/Kadus & Staff Desa (Kasi/Kaur) [Business Workflow] (diselaraskan source 2026-10-16)

skinparam activity {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C0A000
}

|#MistyRose|RT|
start
:Login; terima notifikasi surat baru;
:Buka daftar surat wilayah RT;
:Periksa detail: isian, lampiran,\nstatus tanda tangan, dokumen pendukung;
:Putuskan Setuju / Tolak (catatan wajib bila tolak);
if (Keputusan?) then (Tolak)
  |#LightYellow|Sistem|
  :status rejected (terminal);\nnotifikasi ke pemohon;
  stop
else (Setuju)
  |#LightYellow|Sistem|
  :Lanjut ke step kepala_desa\n(status in_progress);
endif

fork
  |#LightYellow|Sistem|
  :FYI ke RW wilayah RW pemohon;
  |#Lavender|RW|
  :Terima FYI; lihat surat (read-only);
  stop
fork again
  |#LightYellow|Sistem|
  :FYI ke Kadus dusun pemohon;
  |#Honeydew|Kadus|
  :Terima FYI; lihat surat (read-only);
  stop
fork again
  |#LightYellow|Sistem|
  :Notifikasi ke Kepala Desa & Sekdes\n(lihat 04);
end fork

|#LightYellow|Sistem|
:Setelah final approve: notifikasi ke\nKasi/Kaur sesuai assigned_role;

|#LightGreen|Kasi Pemerintahan / Kaur TU & Umum|
if (Jenis surat punya aksi data?) then (ya)
  :Buka surat "perlu diterapkan";
  :Tinjau nilai sekarang vs usulan,\nkoreksi bila perlu;
  :Terapkan;
  |#LightYellow|Sistem|
  :Ubah/tambah data warga,\ncatat audit, beri tahu pemohon;
  |#LightGreen|Kasi Pemerintahan / Kaur TU & Umum|
else (tidak)
endif
:Unduh / cetak surat untuk warga;
stop

note right
  Kasi/Kaur bukan approver flow; dapat
  membaca daftar warga (read-only).
  Kelola data warga, wilayah, CMS tetap
  kewenangan Petugas Desa (04).
end note

@enduml
