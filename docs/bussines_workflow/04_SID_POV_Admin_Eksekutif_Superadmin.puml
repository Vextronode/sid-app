@startuml
title SID - POV Admin Desa, Eksekutif & Superadmin [Business Workflow] (diselaraskan source 2026-10-16)

skinparam activity {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C0A000
}

|#Wheat|Admin Desa (petugas_desa)|
start
:Login;
if (Aktivitas?) then (Kependudukan)
  :CRUD warga & KK, impor Excel,\nsurvei sosio-ekonomi KK,\nkatalog pekerjaan;
  stop
elseif (CMS) then
  :Profil desa (identitas, kop surat,\nlogo, foto beranda, stempel);
  :Berita (1-2 kategori) & kategori berita;
  :Peraturan desa; organisasi non-struktural;
  |#LightYellow|Sistem|
  :Cache halaman publik desa digugurkan;
  stop
elseif (Jabatan & Akun) then
  :Cari calon via NIK; tetapkan/rotasi/turunkan\npejabat (foto wajib);
  :Kelola jenis jabatan tanpa akun;
  :Reset password / reset TTD akun;
  :Unggah TTD Kepala Desa aktif;
  stop
elseif (Konfigurasi Surat) then
  :Ubah masa berlaku, penugasan Kasi/Kaur,\nstatus aktif jenis surat;
  :Atur deadline per level (rt, kepala_desa);
  :Lihat flow approval (read-only);
  stop
else (Monitoring Surat)
  :Lihat seluruh surat desa (semua status);
  :Tanggapi surat tertahan (tetapkan RT);
  :Cadangan Terapkan perubahan data;
  stop
endif

|#Thistle|Eksekutif (kepala_desa / sekretaris_desa)|
:Login; terima notifikasi surat lolos RT;
:Buka daftar surat step kepala_desa\n(tanpa surat milik sendiri);
:Lihat detail + riwayat RT;
:Putuskan Setuju / Tolak;
note right
  Kades & Sekdes saling menggantikan
  (first-action-wins, row lock).
  Eksekutif tidak punya akses CMS.
end note
if (Keputusan?) then (Tolak)
  |#LightYellow|Sistem|
  :rejected (terminal); notifikasi pemohon;
  stop
else (Setuju)
  |#LightYellow|Sistem|
  :approved; nomor surat per kode klasifikasi;
  :Bekukan snapshot (TTD & stempel Kades saat ini);
  :Notifikasi pemohon & Kasi/Kaur;
  stop
endif

|#LightSteelBlue|Superadmin|
note right
  BELUM DIIMPLEMENTASIKAN.
  Tidak ada role/middleware/halaman.
end note

@enduml
