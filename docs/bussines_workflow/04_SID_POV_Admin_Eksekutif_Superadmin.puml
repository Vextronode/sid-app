@startuml
title SID - POV Admin Desa, Eksekutif & Superadmin [Business Workflow] (diselaraskan source 2026-11-19)

skinparam activity {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C0A000
}

|#Wheat|Admin Desa (staf_sid)|
start
:Login;
if (Aktivitas?) then (Kependudukan)
  :CRUD warga & KK, impor Excel,\nsurvei sosio-ekonomi KK,\nkatalog pekerjaan;
  stop
elseif (CMS) then
  :Profil desa (identitas, kop surat,\nlogo, foto beranda);
  :Berita (1-2 kategori) & kategori berita;
  :Peraturan desa; organisasi non-struktural;
  |#LightYellow|Sistem|
  :Cache halaman publik desa digugurkan;
  stop
elseif (Jabatan & Akun) then
  :Cari calon via NIK; tetapkan/rotasi/turunkan\npejabat (foto wajib);
  :Kelola jenis jabatan tanpa akun;
  :Reset password akun;
  :Aktivasi akun & ganti foto warga\n(bila jenjang RT/RW/Kadus kosong);
  :Aktivasi manual NIK yang diblokir\n(kata sandi sementara);
  :Setujui/tolak permintaan lupa sandi\ntanpa email;
  stop
elseif (Konfigurasi Surat) then
  :Ubah masa berlaku, kategori\n(menentukan Kasi/Kaur), status aktif jenis surat;
  :Atur deadline per level (rt, kepala_desa);
  :Lihat flow approval (read-only);
  stop
elseif (Integrasi) then
  :Aktifkan/nonaktifkan Cimart & SIGAP,\nterbitkan/cabut token (konfirmasi sandi);
  :Turunkan / tampilkan lagi peringatan SIGAP;
  stop
elseif (Pemantauan) then
  :Log Aktivitas (data penduduk, surat,\ntindakan akun);
  :Pelanggan Notifikasi (perangkat Web Push);
  :Data Usaha Warga & Data CPMI (baca);
  stop
else (Monitoring Surat)
  :Lihat seluruh surat desa (semua status);
  :Tanggapi surat tertahan (tetapkan RT/Kasi/Kaur);
  stop
endif

|#Thistle|Eksekutif (kepala_desa / sekretaris_desa)|
:Login; terima notifikasi surat lolos RT;
:Buka daftar surat step kepala_desa\n(tanpa surat milik sendiri);
:Lihat detail + riwayat RT;
:Putuskan Setuju / Tolak;
note right
  Kades & Sekdes saling menggantikan
  (first-action-wins, row lock).
  Eksekutif tidak punya akses CMS;
  membaca Data Penduduk & Data CPMI.
end note
if (Keputusan?) then (Tolak)
  |#LightYellow|Sistem|
  :rejected (terminal); notifikasi pemohon;
  stop
else (Setuju)
  |#LightYellow|Sistem|
  :approved; nomor surat per kode klasifikasi\n(Persuratan Desa);
  :Bekukan snapshot (nama Kades saat ini;\ntanpa TTD/stempel, dibubuhkan basah);
  :Catat data hasil layanan\n(Data Usaha dari A01, Data CPMI dari F11);
  :Notifikasi pemohon & Kasi/Kaur;
  stop
endif

|#LightSteelBlue|Superadmin|
note right
  BELUM DIIMPLEMENTASIKAN.
  Tidak ada role/middleware/halaman.
end note

@enduml
