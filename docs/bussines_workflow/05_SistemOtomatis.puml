@startuml
title SID - Proses Otomatis Sistem (aktif di source 2026-10-16) + Reminder (belum diimplementasi)

skinparam activity {
  BackgroundColor #EBF3FB
  BorderColor #2E5FA3
  FontName Arial
  FontSize 11
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C0A000
}

|#LightYellow|Sistem (dipicu request)|
start

fork
  :Daftar surat dimuat;
  :Hitung is_overdue dari deadline_at\napproval pending pada step aktif;
  note right
    Tidak auto-reject; murni penanda.
  end note
fork again
  :Permintaan tanda tangan dibaca;
  :Tandai pending yang lewat expires_at\nmenjadi expired;
fork again
  :Slot tanda tangan terakhir terisi;
  :Pindahkan surat ke step approval pertama;
fork again
  :Step awal tanpa RT aktif;
  :Tahan surat + notifikasi Petugas Desa;
  :Saat RT ditetapkan → notifikasi RT baru;
fork again
  :Final approve;
  :Nomor surat, expires_at, snapshot render;
fork again
  :Data publik berubah (desa, berita, kategori,\nperaturan, jenis surat, pejabat, dusun,\njenis jabatan);
  :Gugurkan cache halaman publik desa;
fork again
  :Notifikasi dibuat (setelah commit);
  :Simpan in-app (sinkron);
  :Antrekan Web Push → kirim ke browser;
end fork

|#LightGray|Rencana (belum ada di source)|
:Scheduler reminder berdasarkan reminder_hours;
note right
  Belum ada scheduler/job; kolom
  reminder_hours dan reminded_at
  belum dipakai. Lihat audit docs.
end note
stop

@enduml
